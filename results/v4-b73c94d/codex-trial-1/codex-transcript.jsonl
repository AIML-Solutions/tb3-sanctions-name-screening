{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"ls -l link.py && python3 -m py_compile link.py && python3 link.py --register register.json --records dev/records_dev.csv --out /tmp/dev_pred.csv && python3 - <<'PY'\nimport csv,collections\np={x['record_id']:x for x in csv.DictReader(open('/tmp/dev_pred.csv'))}\ny=list(csv.DictReader(open('dev/labels_dev.csv')))\nby=collections.defaultdict(lambda:collections.Counter())\nerrs=[]\nfor z in y:\n q=p[z['record_id']]\n ok=q['decision']==z['expected_decision'] and (q['decision']\"'!='\"'MATCH' or q['matched_uid']==z['expected_uid'])\n kind='ok' if ok else ('fn' if z['expected_decision']=='MATCH' and q['decision']=='NO_MATCH' else 'fp' if z['expected_decision']=='NO_MATCH' and q['decision']=='MATCH' else 'wrong_uid')\n by[z['class']][kind]+=1\n if not ok: errs.append((z,q))\nfor k in sorted(by): print(k,dict(by[k]))\nprint('total correct',sum(v['ok'] for v in by.values()),'/',len(y),'errors',len(errs))\nprint('prediction decisions',collections.Counter(x['decision'] for x in p.values()))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
