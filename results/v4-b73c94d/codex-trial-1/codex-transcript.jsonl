{"type":"item.completed","item":{"id":"item_68","type":"command_execution","command":"/bin/bash -lc \"python3 link.py --register register.json --records dev/records_dev.csv --out /tmp/dev_pred10.csv && python3 link.py --register register.json --records records.csv --out /tmp/current_pred8.csv && python3 - <<'PY'\nimport csv,json,sys,difflib\nsys.path.insert(0,'.');import link\nR=json.load(open('register.json'));P={x['record_id']:x for x in csv.DictReader(open('/tmp/current_pred8.csv'))}\n# endpoint candidates (all orderings); diagnostic only\nE=[]\nfor e in R:\n if e['type']\"'!='\"'individual':continue\n ns=[e['primary_name']]+[x['name'] for x in e['aliases'] if x['strength']=='strong']\n forms=[]\n for n in ns:\n  t=link.person_tokens(n)\n  if len(t)>=2: forms += [(t[0],t[-1]),(t[-1],t[0])]\n E.append((e,forms))\ndef ratio(a,b):return difflib.SequenceMatcher(None,a,b).ratio()\nrows=[]\nfor q in csv.DictReader(open('records.csv')):\n if P[q['record_id']]['decision']=='MATCH' or q['type']\"'!='\"'individual' or q['dob']:continue\n t=link.person_tokens(q['full_name']);\n if len(t)<2:continue\n forms=[(t[0],t[-1]),(t[-1],t[0])];best=(0,None,None)\n for e,efs in E:\n  for a,b in forms:\n   for c,d in efs:\n    r1=ratio(a,c);r2=ratio(b,d); s=min(r1,r2)*.6+(r1+r2)*.2\n    if s>best[0]:best=(s,e,(r1,r2))\n rows.append((best[0],q,best[1],best[2]))\nfor sim,q,e,parts in sorted(rows,reverse=True,key=lambda x:x[0]):\n if sim>=.82:print(f'{sim:.2f} {parts} {q[\\\"record_id\\\"]} {q[\\\"full_name\\\"]\"'!r} -> {e[\"uid\"]} {e[\"primary_name\"]!r}'\"')\nPY\"","aggregated_output":"1.00 (1.0, 1.0) C450364 'Juei Hui Ma' -> AR-23934 'Rui Ma'\n1.00 (1.0, 1.0) C322611 'Lei-Hua Yang' -> AR-22791 'Lei Yang'\n0.95 (1.0, 0.9333333333333333) C311556 'Tallalle El-Djabouri' -> AR-32503 'طلال بن فهد الجبوري'\n0.94 (0.9230769230769231, 1.0) C518754 'Schahin, Ahmed' -> AR-32907 'Ahmad bin Kamal Shahin'\n0.93 (1.0, 0.9090909090909091) C964455 'Majeed Sallihi' -> AR-46473 'Majid Saleh'\n0.92 (1.0