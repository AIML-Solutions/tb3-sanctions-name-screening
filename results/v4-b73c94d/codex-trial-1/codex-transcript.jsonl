{"type":"item.started","item":{"id":"item_66","type":"command_execution","command":"/bin/bash -lc \"python3 link.py --register register.json --records records.csv --out /tmp/current_pred7.csv && python3 - <<'PY'\nimport csv,json,sys\nsys.path.insert(0,'.');import link\nR=json.load(open('register.json'));P={x['record_id']:x for x in csv.DictReader(open('/tmp/current_pred7.csv'))}\ndef grams(s):return {s[i:i+2] for i in range(len(s)-1)}\nE=[]\nfor e in R:\n if e['type']=='individual':\n  ns=[e['primary_name'],e.get('script_name') or '']+[x['name'] for x in e['aliases'] if x['strength']=='strong']\n  E.append((e,[(n:= ''.join(link.person_tokens(x)),grams(n)) for x in ns if x]))\nrows=[]\nfor q in csv.DictReader(open('records.csv')):\n if P[q['record_id']]['decision']=='MATCH' or q['type']\"'!='\"'individual' or q['dob']:continue\n a=''.join(link.person_tokens(q['full_name']));ga=grams(a);best=(-1,None)\n for e,ns in E:\n  sim=max((2*len(ga&g)/(len(ga)+len(g)) if ga or g else 1) for n,g in ns)\n  if sim>best[0]:best=(sim,e)\n rows.append((best[0],q,best[1]))\nfor sim,q,e in sorted(rows,reverse=True,key=lambda x:x[0]):\n if sim>=.72:print(f'{sim:.2f} {q[\\\"record_id\\\"]} {q[\\\"full_name\\\"]\"'!r} -> {e[\"uid\"]} {e[\"primary_name\"]!r} dob={e[\"dob\"]}'\"')\nprint('empty unmatched',len(rows),'above',sum(s>=.72 for s,*_ in rows))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
