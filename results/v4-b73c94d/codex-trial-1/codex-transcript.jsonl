{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport csv,json,collections\nreg={x['uid']:x for x in json.load(open('register.json'))}\nrec={x['record_id']:x for x in csv.DictReader(open('dev/records_dev.csv',encoding='utf-8-sig'))}\nlabs=list(csv.DictReader(open('dev/labels_dev.csv',encoding='utf-8-sig')))\nby=collections.defaultdict(list)\nfor l in labs: by[l['class']].append((rec[l['record_id']], reg.get(l['expected_uid'])))\nfor cl in sorted(by):\n print('\\\\n###',cl,len(by[cl]))\n for rr,e in by[cl][:12]:\n  print(rr['record_id'],repr(rr['full_name']),rr['dob'],rr['id_type'],rr['id_number'],'=>',l if False else (e['uid'],repr(e['primary_name']),repr(e['script_name']),e['dob'],[(a['name'],a['strength']) for a in e['aliases']]) if e else 'NO_MATCH')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
