{"type":"item.started","item":{"id":"item_76","type":"command_execution","command":"/bin/bash -lc \"python3 link.py --register register.json --records dev/records_dev.csv --out /tmp/dev_pred11.csv && python3 - <<'PY'\nimport csv,collections\np={x['record_id']:x for x in csv.DictReader(open('/tmp/dev_pred11.csv'))};bad=[]\nfor z in csv.DictReader(open('dev/labels_dev.csv')):\n q=p[z['record_id']]\n if q['decision']\"'!=z['\"'expected_decision'] or(q['decision']=='MATCH' and q['matched_uid']\"'!=z['\"'expected_uid']):bad.append((z,q))\nprint('correct',1334-len(bad),'errors',len(bad));print(*bad,sep='\\\\n')\nPY\npython3 link.py --register register.json --records records.csv --out /tmp/current_pred9.csv\npython3 - <<'PY'\nimport csv,collections\nq={x['record_id']:x for x in csv.DictReader(open('records.csv'))};p=list(csv.DictReader(open('/tmp/current_pred9.csv')));print(collections.Counter((q[x['record_id']]['type'],x['decision']) for x in p))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
