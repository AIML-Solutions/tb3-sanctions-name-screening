{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport sys,csv,json,collections\nsys.path.insert(0,'.'); import link\nR=json.load(open('register.json')); byuid={e['uid']:e for e in R}\nP={x['record_id']:x for x in csv.DictReader(open('/tmp/dev_pred.csv'))}; Q={x['record_id']:x for x in csv.DictReader(open('dev/records_dev.csv'))}\nY=list(csv.DictReader(open('dev/labels_dev.csv')))\nfor cl in sorted(set(z['class'] for z in Y)):\n bad=[]\n for z in Y:\n  if z['class']\"'!=cl:continue\n  p=P[z['\"'record_id']]\n  if p['decision']\"'!=z['\"'expected_decision'] or (p['decision']=='MATCH' and p['matched_uid']\"'!=z['\"'expected_uid']): bad.append((z,p))\n if not bad: continue\n print('\\\\n###',cl,len(bad))\n for z,p in bad:\n  q=Q[z['record_id']]; e=byuid.get(z['expected_uid'])\n  print(q['record_id'],repr(q['full_name']),q['dob'],'PRED',p['decision'],p['matched_uid'],'EXP',z['expected_uid'])\n  if e:\n   print('  <-',repr(e['primary_name']),repr(e['script_name']),e['dob'],[(a['name'],a['strength']) for a in e['aliases']])\n   print('  tok',link.person_tokens(q['full_name']),'vs',link.person_tokens(e['primary_name']))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
