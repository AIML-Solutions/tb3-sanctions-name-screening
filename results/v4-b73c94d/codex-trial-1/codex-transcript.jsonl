{"type":"item.started","item":{"id":"item_86","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport csv,json,sys,difflib\nsys.path.insert(0,'.');import link\nR=json.load(open('register.json'));P={x['record_id']:x for x in csv.DictReader(open('/tmp/current_pred11.csv'))}\n# likely Chinese register entries\nE=[]\nfor e in R:\n if e['type']=='individual' or False:\n  if e.get('script_name'):continue\n  if not any(n in {'CN','HK','TW','SG'} for n in e['nationalities']):continue\n  t=link.person_tokens(e['primary_name'])\n  if len(t)>=2:E.append((e,''.join(t[:-1]),link._surname_forms(t[-1])))\nfor q in csv.DictReader(open('records.csv')):\n if q['type']\"'!='\"'individual' or P[q['record_id']]['decision']=='MATCH' or q['nationality'] not in {'CN','HK','TW','SG'}:continue\n t=link.person_tokens(q['full_name']);\n if len(t)<2:continue\n opts=[(''.join(t[:-1]),link._surname_forms(t[-1])),(''.join(t[1:]),link._surname_forms(t[0]))]\n best=(0,None,'')\n for g,fs in opts:\n  for e,eg,efs in E:\n   if fs&efs:\n    s=difflib.SequenceMatcher(None,g,eg).ratio()\n    if s>best[0]:best=(s,e,eg)\n if best[0]>=.60:print(f'{best[0]:.2f} {q[\\\"record_id\\\"]} {q[\\\"full_name\\\"]\"'!r} dob={q[\"dob\"]} -> {best[1][\"uid\"]} {best[1][\"primary_name\"]!r} dob={best[1][\"dob\"]}'\"')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
