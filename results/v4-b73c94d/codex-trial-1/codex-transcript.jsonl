{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport csv,json,sys,difflib,collections\nsys.path.insert(0,'.');import link\nR=json.load(open('register.json')); P={x['record_id']:x for x in csv.DictReader(open('/tmp/current_pred.csv'))}\nrecs=list(csv.DictReader(open('records.csv')))\nbydob=collections.defaultdict(list)\nfor e in R:\n if e['type']=='individual' and len(e['dob'])==10:bydob[e['dob']].append(e)\nrows=[]\nfor q in recs:\n if P[q['record_id']]['decision']=='MATCH' or q['type']\"'!='\"'individual' or len(q['dob'])\"'!=10:continue\n cand=bydob[q['\"'dob']]\n if not cand:continue\n a=''.join(link.person_tokens(q['full_name']))\n scored=[]\n for e in cand:\n  names=[e['primary_name'],e.get('script_name') or '']+[x['name'] for x in e['aliases'] if x['strength']=='strong']\n  sim=max(difflib.SequenceMatcher(None,a,''.join(link.person_tokens(n))).ratio() for n in names if n)\n  scored.append((sim,e))\n sim,e=max(scored,key=lambda x:x[0]); rows.append((sim,q,e,len(cand)))\nprint('unmatched full dob sharing register DOB',len(rows))\nfor sim,q,e,n in sorted(rows,reverse=True,key=lambda x:x[0]):\n if sim<.35:continue\n print(f'{sim:.2f} n={n} {q[\\\"record_id\\\"]} {q[\\\"full_name\\\"]\"'!r} {q[\"dob\"]} {q[\"nationality\"]} {q[\"id_number\"]} -> {e[\"uid\"]} {e[\"primary_name\"]!r} {e[\"dob\"]}'\"')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
