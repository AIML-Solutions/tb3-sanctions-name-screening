{"type":"item.started","item":{"id":"item_79","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport csv,json,sys,difflib,collections\nsys.path.insert(0,'.');import link\nR=json.load(open('register.json'));P={x['record_id']:x for x in csv.DictReader(open('/tmp/current_pred9.csv'))};E=[];inv=collections.defaultdict(set)\nfor e in R:\n if e['type']\"'!='\"'individual':continue\n fs=[]\n for n in [e['primary_name']]+[x['name'] for x in e['aliases'] if x['strength']=='strong']:\n  t=link.person_tokens(n)\n  if len(t)>=2:fs += [(t[0],t[-1]),(t[-1],t[0])]\n E.append((e,fs));j=len(E)-1\n for a,b in fs:inv[a].add(j);inv[b].add(j)\nvocab=list(inv)\ndef rat(a,b):return difflib.SequenceMatcher(None,a,b).ratio()\nrows=[]\nfor q in csv.DictReader(open('records.csv')):\n if P[q['record_id']]['decision']=='MATCH' or q['type']\"'!='\"'individual' or q['dob']:continue\n t=link.person_tokens(q['full_name']);\n if len(t)<2:continue\n best=(0,None,None)\n for a,b in [(t[0],t[-1]),(t[-1],t[0])]:\n  ca=set().union(*(inv[x] for x in difflib.get_close_matches(a,vocab,n=25,cutoff=.55)))\n  cb=set().union(*(inv[x] for x in difflib.get_close_matches(b,vocab,n=25,cutoff=.55)))\n  for j in ca&cb:\n   e,fs=E[j]\n   for c,d in fs:\n    r1=rat(a,c);r2=rat(b,d);s=.6*min(r1,r2)+.2*(r1+r2)\n    if s>best[0]:best=(s,e,(r1,r2))\n rows.append((best[0],q,best[1],best[2]))\nfor sim,q,e,parts in sorted(rows,reverse=True,key=lambda x:x[0]):\n if sim>=.80:print(f'{sim:.2f} {parts} {q[\\\"record_id\\\"]} {q[\\\"full_name\\\"]\"'!r} -> {e[\"uid\"]} {e[\"primary_name\"]!r}'\"')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
