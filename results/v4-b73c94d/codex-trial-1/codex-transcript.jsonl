{"type":"item.started","item":{"id":"item_43","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport csv,json,sys,difflib,collections\nsys.path.insert(0,'.');import link\nR=json.load(open('register.json'));P={x['record_id']:x for x in csv.DictReader(open('/tmp/current_pred4.csv'))};by=collections.defaultdict(list)\nfor e in R:\n if e['type']=='individual' and len(e['dob'])==10:by[e['dob']].append(e)\nrows=[]\nfor q in csv.DictReader(open('records.csv')):\n if P[q['record_id']]['decision']=='MATCH' or q['type']\"'!='\"'individual' or len(q['dob'])\"'!=10 or not by[q['\"'dob']]:continue\n a=''.join(link.person_tokens(q['full_name']));ss=[]\n for e in by[q['dob']]:\n  ns=[e['primary_name'],e.get('script_name') or '']+[x['name'] for x in e['aliases'] if x['strength']=='strong']\n  ss.append((max(difflib.SequenceMatcher(None,a,''.join(link.person_tokens(n))).ratio() for n in ns if n),e))\n sim,e=max(ss,key=lambda x:x[0]);rows.append((sim,q,e))\nfor sim,q,e in sorted(rows,reverse=True,key=lambda x:x[0]):\n if sim>=.45:print(f'{sim:.2f} {q[\\\"record_id\\\"]} {q[\\\"full_name\\\"]\"'!r} -> {e[\"uid\"]} {e[\"primary_name\"]!r}'\"')\nprint('shared',len(rows))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
