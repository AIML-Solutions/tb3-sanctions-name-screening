{"type":"item.started","item":{"id":"item_64","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport importlib.util,csv,json,collections\nsp=importlib.util.spec_from_file_location('s','/app/screen.py');m=importlib.util.module_from_spec(sp);sp.loader.exec_module(m);W=json.load(open('/app/watchlist.json'));E=m.Engine(W);P={r['customer_id']:r for r in csv.DictReader(open('/tmp/batch4.csv'))};C=list(csv.DictReader(open('/app/customers.csv')))\ndef lev(a,b):\n if abs(len(a)-len(b))>2:return 9\n prev=list(range(len(b)+1))\n for i,x in enumerate(a,1):\n  cur=[i]\n  for j,y in enumerate(b,1):cur.append(min(cur[-1]+1,prev[j]+1,prev[j-1]+(x\"'!=y)))\n  prev=cur\n return prev[-1]\nfam=collections.defaultdict(list)\nfor e in W:\n if e['\"'type']\"'!='\"'individual':continue\n for n in [e['primary_name']]+[a['name'] for a in e['aliases'] if a['strength']=='strong']:\n  t=m.normalized_person_tokens(n)\n  if len(t)>=2:\n   fs=set(E.script_family.get(m.words(n)[-1],())) if not m.is_latin(n) else set()\n   fs.add(m.family_word(t[-1]))\n   gs=set(E.script_given.get(m.words(n)[0],())) if not m.is_latin(n) else set()\n   gs.add(m.latin_word(t[0]))\n   for f in fs:\n    for g in gs:fam[f].append((g,e['uid']))\nallcf=set();cached={}\nfor c in C:\n if c['type']=='individual' and P[c['customer_id']]['decision']=='NO_MATCH':\n  t=m.normalized_person_tokens(c['full_name']);cached[c['customer_id']]=t\n  if len(t)>=2:allcf.update((t[0],t[-1]))\nfn={cf:[ef for ef in fam if lev(cf,ef)<=2] for cf in allcf}\nrows=[]\nfor c in C:\n if c['type']\"'!='\"'individual' or P[c['customer_id']]['decision']\"'!='\"'NO_MATCH':continue\n t=cached[c['customer_id']];cps=[]\n if len(t)>=2:cps=[(t[0],t[-1]),(t[-1],t[0])]\n if len(t)>=3:cps.append((t[1],t[0]))\n best=None\n for cg,cf in cps:\n  for ef in fn.get(cf,[]):\n   fd=lev(cf,ef)\n   for eg,u in fam[ef]:\n    if not m.dob_compatible(c['dob'],E.by_uid[u].get('dob','')):continue\n    gd=lev(cg,eg)\n    if gd>2:continue\n    score=gd+fd\n    if best is None or score<best[0]:best=(score,gd,fd,u,(cg,cf),(eg,ef))\n if best:rows.append((best,c))\nprint('candidates',len(rows))\nfor b,c in sorted(rows,key=lambda z:z[0][0])[:350]:\n score,gd,fd,u,cp,ep=b;e=E.by_uid[u];print(f'{score} g{gd}f{fd}',c['customer_id'],repr(c['full_name']),c['dob'],'=>',u,repr(e['primary_name']),e['dob'],cp,ep)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
