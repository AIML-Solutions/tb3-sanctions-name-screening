{"type":"item.started","item":{"id":"item_142","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport csv,json,collections,importlib.util\nsp=importlib.util.spec_from_file_location('s','/app/screen.py');m=importlib.util.module_from_spec(sp);sp.loader.exec_module(m);W=json.load(open('/app/watchlist.json'));E=m.Engine(W);P={r['customer_id']:r for r in csv.DictReader(open('/tmp/batch12.csv'))};C=list(csv.DictReader(open('/app/customers.csv')))\nregions={'AF','IR','YE','SA','EG','SY','IQ','JO','LB','AE'}\nlex=set(m.ARABIC_PERSIAN.values())\nfor e in W:\n if e['type']=='individual' and m.is_arabic(e.get('script_name') or ''):\n  for n in E.latin_sources(e):\n   t=m.normalized_person_tokens(n)\n   if t:lex.update((t[0],t[-1]))\ndef lev(a,b):\n if abs(len(a)-len(b))>2:return 9\n p=list(range(len(b)+1))\n for i,x in enumerate(a,1):\n  q=[i]\n  for j,y in enumerate(b,1):q.append(min(q[-1]+1,p[j]+1,p[j-1]+(x\"'!=y)))\n  p=q\n return p[-1]\nunk=collections.defaultdict(list)\nfor c in C:\n if c['\"'type']\"'!='\"'individual' or c['nationality'] not in regions or P[c['customer_id']]['decision']\"'!='\"'NO_MATCH':continue\n for raw in m.words(c['full_name']):\n  x=m.latin_word(raw)\n  if len(x)>2 and x not in lex and x not in m.PARTICLES and x not in m.NASAB:\n   near=sorted((lev(x,y),y) for y in lex)\n   if near and near[0][0]<=2:unk[(x,near[0])].append((c['customer_id'],c['full_name'],c['dob']))\nfor (x,(d,y)),ex in sorted(unk.items(),key=lambda z:(z[0][1][0],-len(z[1]),z[0][0])):\n print(x,'->',y,'d',d,'n',len(ex),'|','; '.join(f\\\"{a}:{b}({c})\\\" for a,b,c in ex[:4]))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
