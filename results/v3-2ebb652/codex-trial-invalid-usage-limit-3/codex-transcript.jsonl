{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport csv,json,collections,difflib,re,unicodedata\nW=json.load(open('/app/watchlist.json'));C=list(csv.DictReader(open('/app/dev/customers_dev.csv')));L={r['customer_id']:r for r in csv.DictReader(open('/app/dev/labels_dev.csv'))};D=collections.defaultdict(list)\nfor e in W:\n if len(e['dob'])==10 and e['type']=='individual':D[e['dob']].append(e)\ndef f(s):return re.sub('[\"'^a-z]'\"','', ''.join(x for x in unicodedata.normalize('NFKD',s.lower()) if not unicodedata.combining(x)))\na=[]\nfor c in C:\n if L[c['customer_id']]['expected_decision']=='NO_MATCH' and c['type']=='individual' and len(c['dob'])==10 and c['dob'] in D:\n  for e in D[c['dob']]:\n   sim=max(difflib.SequenceMatcher(None,f(c['full_name']),f(n)).ratio() for n in [e['primary_name']]+[x['name'] for x in e['aliases'] if x['strength']=='strong'])\n   a.append((sim,c,e,L[c['customer_id']]['class']))\nprint(len(a))\nfor sim,c,e,cl in sorted(a,reverse=True,key=lambda x:x[0])[:100]:print(f'{sim:.3f}',cl,c['full_name'],'->',e['primary_name'],c['dob'])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
