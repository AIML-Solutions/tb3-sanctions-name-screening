{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport csv,json,collections,difflib,re,unicodedata\nW=json.load(open('/app/watchlist.json')); C=list(csv.DictReader(open('/app/customers.csv'))); P={r['customer_id']:r for r in csv.DictReader(open('/tmp/batch_initial.csv'))}\nD=collections.defaultdict(list)\nfor e in W:\n if len(e['dob'])==10 and e['type']=='individual':D[e['dob']].append(e)\ndef fold(s):\n s=''.join(c for c in unicodedata.normalize('NFKD',s.lower()) if not unicodedata.combining(c));return re.sub('[\"'^a-z]'\"','',s)\nrows=[]\nfor c in C:\n if c['type']=='individual' and P[c['customer_id']]['decision']=='NO_MATCH' and len(c['dob'])==10 and c['dob'] in D:\n  for e in D[c['dob']]:\n   names=[e['primary_name']]+[a['name'] for a in e['aliases'] if a['strength']=='strong']\n   sim=max(difflib.SequenceMatcher(None,fold(c['full_name']),fold(n)).ratio() for n in names)\n   rows.append((sim,c,e))\nprint('unmatched full-date with exact watch date pairs',len(rows),'customers',len(set(x[1]['customer_id'] for x in rows)))\nfor sim,c,e in sorted(rows,key=lambda x:-x[0])[:250]:print(f\\\"{sim:.3f}\\\",c['customer_id'],repr(c['full_name']),'->',e['uid'],repr(e['primary_name']),[a['name'] for a in e['aliases'] if a['strength']=='strong'])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
