{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport csv,json,collections,unicodedata,re\nW=json.load(open('/app/watchlist.json'))\nC=list(csv.DictReader(open('/app/dev/customers_dev.csv')))\nL={x['customer_id']:x for x in csv.DictReader(open('/app/dev/labels_dev.csv'))}\nprint('watch',len(W),'dev',len(C))\nprint('types',collections.Counter(x['type'] for x in W))\nprint('classes')\nfor k,v in sorted(collections.Counter(x['class'] for x in L.values()).items()): print(k,v)\nprint('original-only',sum(any(ord(ch)>127 for ch in x['primary_name']) and not any(ord(ch)<128 and ch.isalpha() for ch in x['primary_name']) for x in W))\nprint('aliases',collections.Counter(a['strength'] for x in W for a in x['aliases']))\nprint('\\\\nSAMPLES BY CLASS')\nby=collections.defaultdict(list)\nfor c in C: by[L[c['customer_id']]['class']].append(c)\nwm={x['uid']:x for x in W}\nfor cls in sorted(by):\n print('\\\\n###',cls)\n for c in by[cls][:12]:\n  lab=L[c['customer_id']]; w=wm.get(lab['expected_uid'])\n  print(c['customer_id'],repr(c['full_name']),c['dob'],c['id_type'],c['id_number'],'=>',lab['expected_decision'],lab['expected_uid'], ('| '+w['primary_name']+' | '+str(w['script_name'])+' | '+str(w['aliases'])+' |dob='+w['dob']) if w else '')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
