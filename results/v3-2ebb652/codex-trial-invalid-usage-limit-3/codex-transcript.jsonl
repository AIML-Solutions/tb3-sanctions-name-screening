{"type":"item.started","item":{"id":"item_60","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport importlib.util,csv,json,collections\nsp=importlib.util.spec_from_file_location('s','/app/screen.py');m=importlib.util.module_from_spec(sp);sp.loader.exec_module(m);W=json.load(open('/app/watchlist.json'));E=m.Engine(W);P={r['customer_id']:r for r in csv.DictReader(open('/tmp/batch4.csv'))};C=list(csv.DictReader(open('/app/customers.csv')))\ndef lev(a,b):\n if abs(len(a)-len(b))>3:return 9\n prev=list(range(len(b)+1))\n for i,x in enumerate(a,1):\n  cur=[i]\n  for j,y in enumerate(b,1):cur.append(min(cur[-1]+1,prev[j]+1,prev[j-1]+(x\"'!=y)))\n  prev=cur\n return prev[-1]\n# retain representative unexpanded primary-like pairs: all are okay, dedup\nfam=collections.defaultdict(list)\nfor (g,f),uids in E.person_index.items():\n for u in uids:fam[f].append((g,u))\nrows=[]\nfor c in C:\n if c['\"'type']\"'!='\"'individual' or P[c['customer_id']]['decision']\"'!='\"'NO_MATCH':continue\n t=m.normalized_person_tokens(c['full_name']); cps=[]\n if len(t)>=2:cps=[(t[0],t[-1]),(t[-1],t[0])]\n if len(t)>=3:cps.append((t[1],t[0]))\n best=None\n for cg,cf in cps:\n  for ef, vals in fam.items():\n   fd=lev(cf,ef)\n   if fd>max(1,min(3,max(len(cf),len(ef))//4)):continue\n   for eg,u in vals:\n    if not m.dob_compatible(c['dob'],E.by_uid[u].get('dob','')):continue\n    gd=lev(cg,eg)\n    if gd>max(1,min(3,max(len(cg),len(eg))//4)):continue\n    score=gd+fd+abs(len(cg)-len(eg))*.1+abs(len(cf)-len(ef))*.1\n    if best is None or score<best[0]:best=(score,gd,fd,u,(cg,cf),(eg,ef))\n if best:rows.append((best,c))\nprint('candidates',len(rows))\nfor b,c in sorted(rows,key=lambda z:z[0][0])[:300]:\n score,gd,fd,u,cp,ep=b;e=E.by_uid[u];print(f'{score:.1f} g{gd}f{fd}',c['customer_id'],repr(c['full_name']),c['dob'],'=>',u,repr(e['primary_name']),e['dob'],cp,ep)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
