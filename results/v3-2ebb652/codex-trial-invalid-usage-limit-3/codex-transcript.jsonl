{"type":"item.started","item":{"id":"item_45","type":"command_execution","command":"/bin/bash -lc \"python3 /app/screen.py --watchlist /app/watchlist.json --customers /app/dev/customers_dev.csv --out /tmp/dev3.csv && python3 /app/screen.py --watchlist /app/watchlist.json --customers /app/customers.csv --out /tmp/batch3.csv && python3 - <<'PY'\nimport csv,json,collections,difflib,re,unicodedata\np={r['customer_id']:r for r in csv.DictReader(open('/tmp/dev3.csv'))};L=list(csv.DictReader(open('/app/dev/labels_dev.csv')));C={r['customer_id']:r for r in csv.DictReader(open('/app/dev/customers_dev.csv'))};err=[]\nfor l in L:\n x=p[l['customer_id']]\n if not(x['decision']==l['expected_decision'] and (x['decision']=='NO_MATCH' or x['matched_uid']==l['expected_uid'])):err.append((l,x,C[l['customer_id']]))\nprint('DEV ERRORS',len(err));[print(x) for x in err]\nW=json.load(open('/app/watchlist.json'));C=list(csv.DictReader(open('/app/customers.csv')));P={r['customer_id']:r for r in csv.DictReader(open('/tmp/batch3.csv'))};D=collections.defaultdict(list)\nfor e in W:\n if e['type']=='individual' and len(e['dob'])==10:D[e['dob']].append(e)\ndef f(s):return re.sub('[\"'^a-z]'\"','', ''.join(x for x in unicodedata.normalize('NFKD',s.lower()) if not unicodedata.combining(x)))\na=[]\nfor c in C:\n if c['type']=='individual' and P[c['customer_id']]['decision']=='NO_MATCH' and len(c['dob'])==10 and c['dob'] in D:\n  for e in D[c['dob']]:\n   names=[e['primary_name']]+[x['name'] for x in e['aliases'] if x['strength']=='strong'];sim=max(difflib.SequenceMatcher(None,f(c['full_name']),f(n)).ratio() for n in names);a.append((sim,c,e))\nprint('BATCH',collections.Counter(x['decision'] for x in P.values()),'unmatched exact DOB candidates',len(a))\nfor sim,c,e in sorted(a,key=lambda z:-z[0])[:170]: print(f'{sim:.3f}',c['customer_id'],repr(c['full_name']),'->',e['uid'],repr(e['primary_name']))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
