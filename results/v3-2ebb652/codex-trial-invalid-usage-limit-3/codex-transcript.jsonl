{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"python3 -m py_compile /app/screen.py && /usr/bin/time -f 'elapsed=%e rss=%MKB' python3 /app/screen.py --watchlist /app/watchlist.json --customers /app/dev/customers_dev.csv --out /tmp/dev_decisions.csv && python3 - <<'PY'\nimport csv,collections\npred={r['customer_id']:r for r in csv.DictReader(open('/tmp/dev_decisions.csv'))}\nlabels=list(csv.DictReader(open('/app/dev/labels_dev.csv')))\nby=collections.defaultdict(lambda:collections.Counter())\nerrors=[]\nfor l in labels:\n p=pred[l['customer_id']]\n ok=p['decision']==l['expected_decision'] and (p['decision']=='NO_MATCH' or p['matched_uid']==l['expected_uid'])\n by[l['class']]['n']+=1;by[l['class']]['ok']+=ok\n if l['expected_decision']=='MATCH':\n  by[l['class']]['tp'] += p['decision']=='MATCH'\n  by[l['class']]['uid'] += p['matched_uid']==l['expected_uid']\n else: by[l['class']]['fp'] += p['decision']=='MATCH'\n if not ok: errors.append((l,p))\nfor cls,c in sorted(by.items()): print(f\\\"{cls:30} n={c['n']:3} ok={c['ok']:3} tp={c['tp']:3} fp={c['fp']:3} uid={c['uid']:3}\\\")\ntp=sum(c['tp'] for c in by.values()); pos=sum(c['n'] for k,c in by.items() if k.startswith('T'))\nfp=sum(c['fp'] for c in by.values()); pp=tp+fp\nuid=sum(c['uid'] for c in by.values())\nprint('overall true',pos,'TP',tp,'recall',tp/pos,'FP',fp,'precision',tp/pp if pp else 0,'uid',uid/pos,'errors',len(errors))\nprint('first errors')\nC={r['customer_id']:r for r in csv.DictReader(open('/app/dev/customers_dev.csv'))}\nfor l,p in errors[:120]: print(l['class'],l['customer_id'],repr(C[l['customer_id']]['full_name']),C[l['customer_id']]['dob'],'exp',l['expected_decision'],l['expected_uid'],'got',p['decision'],p['matched_uid'])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
