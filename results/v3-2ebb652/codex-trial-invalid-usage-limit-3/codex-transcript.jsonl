{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json,re,collections\nW=json.load(open('/app/watchlist.json'))\ndef latin(s): return any('a'<=c.lower()<='z' for c in s)\ndef toks(s): return re.findall(r\\\"[\"'^'\"\\\\W\\\\d_]+\\\",s.lower(),re.UNICODE)\nfor sc in ['arab','cyr']:\n paired=collections.Counter(); orig=[]\n for e in W:\n  sn=e.get('script_name')\n  if not sn: continue\n  iscy=any('\\\\u0400'<=c<='\\\\u052f' for c in sn)\n  if (sc=='cyr')\"'!=iscy: continue\n  lat=[]\n  if latin(e['\"'primary_name']):lat.append(e['primary_name'])\n  lat += [a['name'] for a in e['aliases'] if a['strength']=='strong' and latin(a['name'])]\n  st=toks(sn)\n  if lat:\n   paired[st[0]]+=1;paired[st[-1]]+=1\n  else: orig.append((e['uid'],st,e['primary_name']))\n miss=[]\n for uid,st,n in orig:\n  if st[0] not in paired or st[-1] not in paired:miss.append((uid,st,n,paired[st[0]],paired[st[-1]]))\n print(sc,'paired endpoint vocab',len(paired),'orig entries',len(orig),'miss',len(miss))\n print(miss[:30])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
