{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport csv,json,collections\nfor p in ['/app/customers.csv','/app/dev/customers_dev.csv']:\n c=list(csv.DictReader(open(p)))\n print(p,len(c),collections.Counter(x['type'] for x in c))\n print('id',sum(bool(x['id_number']) for x in c),'dob',sum(bool(x['dob']) for x in c),'nonlatin',sum(any(ord(z)>127 and not z.isascii() for z in x['full_name']) for x in c))\nW={x['uid']:x for x in json.load(open('/app/watchlist.json'))}\nC={x['customer_id']:x for x in csv.DictReader(open('/app/dev/customers_dev.csv'))}\nL=list(csv.DictReader(open('/app/dev/labels_dev.csv')))\nfor cls in ['T1_translit','T2_script','T3_structure','T10_stacked','T11_twin','T13_id_unlisted_name_match']:\n print('\\\\n###',cls)\n for l in L:\n  if l['class']==cls:\n   c=C[l['customer_id']]; w=W[l['expected_uid']]\n   aliases='; '.join(a['name'] for a in w['aliases'] if a['strength']=='strong')\n   print(f\\\"{c['full_name']\"'!r:40} -> {w['\"'primary_name']\"'!r:42} | {aliases}\")\nPY'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
