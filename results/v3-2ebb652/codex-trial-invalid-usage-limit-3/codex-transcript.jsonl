{"type":"item.started","item":{"id":"item_57","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport importlib.util,csv,json,difflib,collections\nsp=importlib.util.spec_from_file_location('s','/app/screen.py');m=importlib.util.module_from_spec(sp);sp.loader.exec_module(m)\nW=json.load(open('/app/watchlist.json'));E=m.Engine(W);P={r['customer_id']:r for r in csv.DictReader(open('/tmp/batch4.csv'))};C=list(csv.DictReader(open('/app/customers.csv')))\n# Simple raw structural endpoints, retaining second-as-given alternative.\ndef candpairs(n):\n t=m.normalized_person_tokens(n); out=[]\n if len(t)>=2:\n  out += [(t[0],t[-1]),(t[-1],t[0])]\n  if len(t)>=3:out += [(t[1],t[0])]\n return out\ndef sim(a,b):return difflib.SequenceMatcher(None,a,b).ratio()\n# Semantic watch primary/strong pairs from already built index, one representative pair per uid.\nuidpairs=collections.defaultdict(set)\nfor pair,uids in E.person_index.items():\n for u in uids:uidpairs[u].add(pair)\nrows=[]\nfor c in C:\n if c['type']\"'!='\"'individual' or P[c['customer_id']]['decision']\"'!='\"'NO_MATCH':continue\n best=None\n for cp in candpairs(c['full_name']):\n  for u,eps in uidpairs.items():\n   e=E.by_uid[u]\n   if not m.dob_compatible(c['dob'],e.get('dob','')):continue\n   for ep in eps:\n    sg=sim(cp[0],ep[0]);sf=sim(cp[1],ep[1]); score=min(sg,sf)*0.7+(sg+sf)*0.15\n    if min(sg,sf)>=.55 and (best is None or score>best[0]):best=(score,sg,sf,u,ep,cp)\n if best:rows.append((best,c))\nfor best,c in sorted(rows,key=lambda z:-z[0][0])[:250]:\n score,sg,sf,u,ep,cp=best;e=E.by_uid[u]\n print(f'{score:.3f} g{sg:.2f} f{sf:.2f}',c['customer_id'],repr(c['full_name']),c['dob'],'=>',u,repr(e['primary_name']),e['dob'],'pairs',cp,ep)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
