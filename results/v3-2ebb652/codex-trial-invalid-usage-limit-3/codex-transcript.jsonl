{"type":"item.started","item":{"id":"item_96","type":"command_execution","command":"/bin/bash -lc \"python3 /app/screen.py --watchlist /app/watchlist.json --customers /app/customers.csv --out /tmp/batch8.csv\npython3 - <<'PY'\nimport csv,json,collections,re,importlib.util\nP=list(csv.DictReader(open('/tmp/batch8.csv')));print('batch',collections.Counter(x['decision'] for x in P))\nsp=importlib.util.spec_from_file_location('s','/app/screen.py');m=importlib.util.module_from_spec(sp);sp.loader.exec_module(m);W=json.load(open('/app/watchlist.json'));E=m.Engine(W)\nfor culture, pred in [('arabic',lambda e:m.is_arabic(e.get('script_name') or '')),('russian',lambda e:m.is_cyrillic(e.get('script_name') or '')),('chinese',lambda e:any(x in {'CN','HK','TW','SG'} for x in e['nationalities']))]:\n giv=collections.Counter();fam=collections.Counter()\n for e in W:\n  if e['type']\"'!='\"'individual' or not pred(e):continue\n  for n in E.latin_sources(e) or [e.get('script_name') or e['primary_name']]:\n   ps=E._personal_pairs(n)\n   for g,f in ps:\n    if len(g)>1 and len(f)>1:giv[g]+=1;fam[f]+=1\n print('\\\\n',culture,'entries',sum(1 for e in W if e['type']=='individual' and pred(e)))\n print('givens',sorted(giv))\n print('families',sorted(fam))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
