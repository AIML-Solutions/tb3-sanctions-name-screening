{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport csv,json,re\nW={e['uid']:e for e in json.load(open('/app/watchlist.json'))};C={r['customer_id']:r for r in csv.DictReader(open('/app/dev/customers_dev.csv'))}\nfor l in csv.DictReader(open('/app/dev/labels_dev.csv')):\n if l['expected_decision']=='MATCH':\n  c=C[l['customer_id']];e=W[l['expected_uid']]\n  if any(x in (c['full_name']+' '+e['primary_name']).lower() for x in ['mayer','meyer']):print(l['class'],c['full_name'],'->',e['primary_name'])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
