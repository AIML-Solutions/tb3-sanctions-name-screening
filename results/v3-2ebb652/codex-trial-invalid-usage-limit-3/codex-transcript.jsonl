{"type":"item.started","item":{"id":"item_97","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport importlib.util,json\nsp=importlib.util.spec_from_file_location('s','/app/screen.py');m=importlib.util.module_from_spec(sp);sp.loader.exec_module(m);W=json.load(open('/app/watchlist.json'));E=m.Engine(W)\ntests=[]\ndef add(find, new):\n es=[e for e in W if e['type']=='individual' and find.lower() in e['primary_name'].lower()]\n if not es:print('NO TARGET',find);return\n e=es[0];tests.append((new,e))\nadd('Jamal Khoury','Cemal Khoury')\nadd('Hussein Awad','Hüseyin Awad')\nadd('Ahmad Mahdi','Ahmet Mahdi')\nadd('Zainab Qasim','Zainab Kasım')\nadd('Ahmad Mahdi','Achmad Mahdi')\nadd('Yusuf Awad','Joesoef Awad')\nadd('Gennady Petrovich Chaikovsky','Gennady Petrovich Cajkovskij')\nadd('Galina Zhukova','Galina Zukova')\nadd('Dmitri Shevchenko','Dmitri Sevcenko')\nadd('Aleksandr Shcherbakov','Aleksandr Scerbakov')\nfor surname,alt in [('Chen','Tan'),('Lin','Lim'),('Wang','Ong'),('Wu','Goh'),('Zhang','Teo')]:\n es=[e for e in W if e['type']=='individual' and e['primary_name'].split()[-1]==surname]\n e=es[0]; parts=e['primary_name'].split(); tests.append((' '.join(parts[:-1]+[alt]),e))\nfor name,e in tests:\n c={'full_name':name,'dob':e['dob'],'type':'individual','id_type':'','id_number':''};got=E.screen(c);print(('OK' if got==('MATCH',e['uid']) else 'FAIL'),repr(name),'expected',e['uid'],e['primary_name'],e['dob'],'got',got)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
