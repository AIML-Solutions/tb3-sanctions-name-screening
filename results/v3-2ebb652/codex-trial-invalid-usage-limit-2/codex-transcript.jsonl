{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json,csv,difflib,unidecode,sys,re,unicodedata\nw=json.load(open('/app/watchlist.json'))\ndef a(s):\n s=''.join(c for c in unicodedata.normalize('NFKD',s.lower()) if not unicodedata.combining(c))\n return ''.join(c for c in s if c.isascii() and c.isalpha())\ncs=list(csv.DictReader(open('/app/dev/customers_dev.csv'))); ls={r['customer_id']:r for r in csv.DictReader(open('/app/dev/labels_dev.csv'))}\nfor c in cs:\n if ls[c['customer_id']]['class']=='D2_near_name':\n  q=a(c['full_name']); cand=sorted(((difflib.SequenceMatcher(None,q,a(e['primary_name'])).ratio(),e) for e in w if e['type']==c['type']),key=lambda z:z[0],reverse=True)[:3]\n  print(c['full_name'],'dob',c['dob'],'=>','; '.join(f\\\"{s:.2f} {e['uid']} {e['primary_name']} {e['dob']}\\\" for s,e in cand))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
