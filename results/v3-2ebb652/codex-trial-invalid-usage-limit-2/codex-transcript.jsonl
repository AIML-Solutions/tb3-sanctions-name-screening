{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json,re,unicodedata,collections\nw=json.load(open('/app/watchlist.json'))\nfor typ in ('individual','entity','vessel'):\n print('\\\\n',typ)\n for e in [x for x in w if x['type']==typ][:5]: print(e['uid'],e['primary_name'],[(a['name'],a['strength']) for a in e['aliases']],e['dob'])\nind=[e for e in w if e['type']=='individual']\norig=[e for e in ind if all(ord(c)>127 or not c.isalpha() for c in e['primary_name'])]\nprint('\\\\noriginal only',len(orig))\nfor e in orig[:80]: print(e['uid'],e['primary_name'],'aliases',[(a['name'],a['strength']) for a in e['aliases']],e['dob'])\n# unique script whitespace words and latin words in primary names\nscriptwords=collections.Counter()\nlatinwords=collections.Counter()\nfor e in ind:\n for s in (e['primary_name'],e.get('script_name') or ''):\n  for t in re.findall(r\\\"[\"'^'\"\\\\W\\\\d_]+\\\",s.lower(),re.UNICODE):\n   (scriptwords if any(ord(c)>127 and not ('À'<=c<='ž') for c in t) else latinwords)[t]+=1\nprint('\\\\nscript words',len(scriptwords))\nprint(' '.join(scriptwords))\nprint('\\\\nlatin primary words',len(latinwords))\nprint(' '.join(sorted(latinwords)))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
