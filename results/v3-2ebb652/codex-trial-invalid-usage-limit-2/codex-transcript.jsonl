{"type":"item.completed","item":{"id":"item_3","type":"agent_message","text":"The policy makes identifiers deterministic, while the difficult part is conservative multilingual name equivalence: DOB conflicts must veto similar names, and weak aliases require an exact full-date corroboration. I’m mapping the development classes and watchlist structure now so the transliteration logic generalizes beyond observed spellings without becoming fuzzy enough to admit look-alikes."}}
{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"wc -l /app/dev/*.csv && python3 - <<'PY'\nimport csv, json, collections\nwith open('/app/watchlist.json',encoding='utf-8') as f: w=json.load(f)\nwith open('/app/dev/customers_dev.csv',newline='',encoding='utf-8') as f: c={r['customer_id']:r for r in csv.DictReader(f)}\nwith open('/app/dev/labels_dev.csv',newline='',encoding='utf-8') as f: labs=list(csv.DictReader(f))\nbyuid={e['uid']:e for e in w}\nprint('watchlist',len(w),collections.Counter(e['type'] for e in w))\nprint('original only',sum(not any(ord(x)>127 for x in e['primary_name']) and False for e in w),sum(all(ord(x)>127 or not x.isalpha() for x in e['primary_name']) for e in w))\nprint('aliases',collections.Counter(a['strength'] for e in w for a in e['aliases']))\nprint('customers',len(c),'labels',len(labs))\nfor cls,n in sorted(collections.Counter(r['class'] for r in labs).items()):\n    pos=sum(r['expected_decision']=='MATCH' for r in labs if r['class']==cls)\n    print(f'{cls:30} n={n:3} match={pos:3}')\nprint('\\\\nEXAMPLES')\nfor cls in sorted(set(r['class'] for r in labs)):\n    print('\\\\n###',cls)\n    rs=[r for r in labs if r['class']==cls]\n    for r in rs[:12]:\n        x=c[r['customer_id']]\n        if r['expected_uid']:\n            e=byuid[r['expected_uid']]\n            print(r['expected_decision'],r['expected_uid'],'|',x['full_name'],'| dob',x['dob'],'id',x['id_type'],x['id_number'],'||',e['primary_name'],'/',e.get('script_name'),'aliases',[(a['name'],a['strength']) for a in e['aliases']],'dob',e['dob'])\n        else: print(r['expected_decision'],'|',x['full_name'],'| dob',x['dob'],'id',x['id_type'],x['id_number'])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
