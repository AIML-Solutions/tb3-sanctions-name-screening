{"type":"item.started","item":{"id":"item_163","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport csv,json,re,difflib,sys\nsys.path.insert(0,'/app'); import screen\nes=json.load(open('/app/watchlist.json')); eng=screen.ScreeningEngine(es)\nrus=[]\nfor e in es:\n if e['type']=='individual' and screen.has_cyrillic(str(e.get('script_name') or e.get('primary_name') or '')):\n  for n in [e.get('primary_name','')]+[a['name'] for a in e.get('aliases',[]) if a['strength']=='strong']:\n   if n and re.search('[A-Za-z]',str(n)): rus.append((e,str(n)))\ndef toks(s):\n return [w for w in screen.words(s) if len(w)>1 and not screen.is_patronymic(w)]\ndef sim(a,b):\n A=toks(a); B=toks(b)\n # best per token in smaller direction, plus concatenated sorted similarity\n if not A or not B:return 0\n x=sum(max(difflib.SequenceMatcher(None,u,v).ratio() for v in B) for u in A)/len(A)\n y=sum(max(difflib.SequenceMatcher(None,v,u).ratio() for u in A) for v in B)/len(B)\n return min(x,y)\ndef hasname(c):\n for f,idx in [(screen.literal_signatures,eng.literal_index),(screen.western_signatures,eng.western_index),(lambda x:screen.arabic_signatures(x,eng.arabic_script_lexicon),eng.arabic_index),(screen.russian_signatures,eng.russian_index),(screen.chinese_signatures,eng.chinese_index)]:\n  for k in f(c['full_name']):\n   if idx.get(k):return 1\n return 0\nrows=[]\nfor c in csv.DictReader(open('/app/customers.csv')):\n if c['type']\"'!='\"'individual' or eng.screen(c)[0]=='MATCH' or hasname(c):continue\n pool=[]\n for e,n in rus:\n  if c['nationality'] not in e.get('nationalities',[]):continue\n  cd,ed=c['dob'],str(e.get('dob') or '')\n  if cd and ed and not ed.startswith(cd):continue\n  pool.append((sim(c['full_name'],n),e['uid'],n,ed))\n if pool:\n  b=max(pool)\n  if b[0]>=.72:rows.append((b,c))\nprint('Russian diagnostic',len(rows))\nfor b,c in sorted(rows,reverse=True):print(f\\\"{b[0]:.3f} {c['customer_id']} {c['full_name']\"'!r} {c['\"'dob']} {c['nationality']} -> {b[1:]}\\\" )\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
