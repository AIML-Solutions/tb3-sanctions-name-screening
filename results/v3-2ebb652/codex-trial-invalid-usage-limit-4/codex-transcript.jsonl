{"type":"item.started","item":{"id":"item_88","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json,re,screen,collections\nwl=json.load(open('watchlist.json'));eng=screen.ScreeningEngine(wl)\ndef latin_name(e):\n ns=[]\n if not screen.has_arabic(e['primary_name']) and not screen.has_cyrillic(e['primary_name']):ns.append(e['primary_name'])\n ns += [a['name'] for a in e['aliases'] if a['strength']=='strong' and not screen.has_arabic(a['name']) and not screen.has_cyrillic(a['name'])]\n return ns[0] if ns else None\ndef repl(name,mp):\n out=[]\n for x in screen.words(name):out.append(mp.get(screen.ascii_fold(x),x))\n return ' '.join(out)\nsets={\n'Turkish':{'ahmad':'Ahmet','ahmed':'Ahmet','hussein':'Hüseyin','husain':'Hüseyin','hussain':'Hüseyin','jamal':'Cemal','qasim':'Kasım','kasim':'Kasım'},\n'Indonesian':{'ahmad':'Achmad','ahmed':'Achmad','yusuf':'Joesoef','yussof':'Joesoef','muhammad':'Muhamad','mohammed':'Muhamad','mohamed':'Muhamad'},\n'Scientific':{'chaikovsky':'Cajkovskij','chaikovskaya':'Cajkovskaja','zhukov':'Zukov','zhukova':'Zukova','shevchenko':'Sevcenko','shcherbakov':'Scerbakov','shcherbakova':'Scerbakova','tsvetkov':'Cvetkov','tsvetkova':'Cvetkova','yashin':'Jasin','yashina':'Jasina','yakovlev':'Jakovlev','yakovleva':'Jakovleva','sergei':'Sergej','sergey':'Sergej','yuri':'Jurij','yuriy':'Jurij','aleksei':'Aleksej','alexey':'Aleksej','arkady':'Arkadij','dmitri':'Dmitrij','dmitry':'Dmitrij','dmitriy':'Dmitrij'},\n'Hokkien':{'chen':'Tan','lin':'Lim','wang':'Ong','wu':'Goh','zhang':'Teo'},\n}\nfor label,mp in sets.items():\n ok=miss=0; ex=[]\n for e in wl:\n  if e['type']\"'!='\"'individual':continue\n  n=latin_name(e)\n  if not n or not any(x in mp for x in screen.words(n)):continue\n  v=repl(n,mp)\n  c={'full_name':v,'dob':e['dob'],'id_type':'','id_number':'','type':'individual'}\n  got=eng.screen(c)\n  # expected tie baseline is what original exact/list name resolves to\n  base=eng.screen({**c,'full_name':n})\n  if got==base and got[0]=='MATCH':ok+=1\n  else:miss+=1;ex.append((n,v,e['uid'],e['dob'],base,got))\n print(label,'ok',ok,'miss',miss)\n for x in ex[:20]:print(' ',x)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
