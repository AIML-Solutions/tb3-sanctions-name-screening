{"type":"item.started","item":{"id":"item_157","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport csv,json,re,difflib,sys\nfrom collections import defaultdict,Counter\nsys.path.insert(0,'/app'); import screen\nes=json.load(open('/app/watchlist.json')); eng=screen.ScreeningEngine(es)\ndef hasname(c):\n n=c['full_name']; out=set()\n funcs=[(screen.literal_signatures,eng.literal_index),(screen.western_signatures,eng.western_index),(lambda x:screen.arabic_signatures(x,eng.arabic_script_lexicon),eng.arabic_index),(screen.russian_signatures,eng.russian_index),(screen.chinese_signatures,eng.chinese_index)]\n for f,idx in funcs:\n  for k in f(n):\n   if idx.get(k): return True\n return False\ndef norm(s): return ''.join(sorted(x for x in screen.words(s) if len(x)>1))\ndef grams(s): return {s[i:i+3] for i in range(max(1,len(s)-2))}\nwn=[]; inv=defaultdict(set)\nfor e in es:\n if e['type']\"'!='\"'individual': continue\n for n in [e.get('primary_name','')]+[a['name'] for a in e.get('aliases',[]) if a['strength']=='strong']:\n  if n and re.search('[A-Za-z]',n):\n   idx=len(wn); nn=norm(str(n)); wn.append((str(e['uid']),str(n),nn))\n   for g in grams(nn): inv[g].add(idx)\nmatched={r['customer_id'] for r in csv.DictReader(open('/tmp/decisions_final_candidate.csv')) if r['decision']=='MATCH'}\nrows=[]\nfor c in csv.DictReader(open('/app/customers.csv')):\n if c['type']\"'!='\"'individual' or c['customer_id'] in matched: continue\n nk=norm(c['full_name']); gg=grams(nk); counts=Counter()\n for g in gg: counts.update(inv.get(g,()))\n prelim=[i for i,_ in counts.most_common(60)]\n if not prelim: continue\n best=max((difflib.SequenceMatcher(None,nk,wn[i][2]).ratio(),wn[i][0],wn[i][1]) for i in prelim)\n if best[0]>=.78 and not hasname(c): rows.append((best,c))\nprint('no name candidate approximate >=.78',len(rows))\nfor b,c in sorted(rows,reverse=True,key=lambda x:x[0][0]):\n e=eng.entries[b[1]]\n print(f\\\"{b[0]:.3f} {c['customer_id']} {c['full_name']\"'!r} dob={c['\"'dob']} -> {b[1]} {b[2]\"'!r} dob={e.get('\"'dob')} nat={e.get('nationalities')}\\\")\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
