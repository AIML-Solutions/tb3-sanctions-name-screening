{"type":"item.started","item":{"id":"item_166","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport csv,json,re,difflib,sys\nsys.path.insert(0,'/app'); import screen\nes=json.load(open('/app/watchlist.json')); eng=screen.ScreeningEngine(es)\narr=[]\nfor e in es:\n if e['type']=='individual' and screen.has_arabic(str(e.get('script_name') or e.get('primary_name') or '')):\n  for n in [e.get('primary_name','')]+[a['name'] for a in e.get('aliases',[]) if a['strength']=='strong']:\n   if n and re.search('[A-Za-z]',str(n)): arr.append((e,str(n)))\ndef toks(s): return [w for w in screen._arabic_core_words(s) if len(w)>1]\ndef sim(a,b):\n A=toks(a);B=toks(b)\n if not A or not B:return 0\n def ts(u,v):return difflib.SequenceMatcher(None,screen.ascii_fold(u),screen.ascii_fold(v)).ratio()\n x=sum(max(ts(u,v) for v in B) for u in A)/len(A); y=sum(max(ts(v,u) for u in A) for v in B)/len(B)\n return min(x,y)\ndef hasname(c):\n for f,idx in [(screen.literal_signatures,eng.literal_index),(screen.western_signatures,eng.western_index),(lambda x:screen.arabic_signatures(x,eng.arabic_script_lexicon),eng.arabic_index),(screen.russian_signatures,eng.russian_index),(screen.chinese_signatures,eng.chinese_index)]:\n  if any(idx.get(k) for k in f(c['full_name'])):return 1\n return 0\nrows=[]\nfor c in csv.DictReader(open('/app/customers.csv')):\n if c['type']\"'!='\"'individual' or eng.screen(c)[0]=='MATCH' or hasname(c):continue\n pool=[]\n for e,n in arr:\n  if c['nationality'] not in e.get('nationalities',[]):continue\n  cd,ed=c['dob'],str(e.get('dob') or '')\n  if cd and ed and not ed.startswith(cd):continue\n  pool.append((sim(c['full_name'],n),e['uid'],n,ed))\n if pool:\n  b=max(pool)\n  if b[0]>=.70:rows.append((b,c))\nprint('Arabic/Persian diagnostic',len(rows))\nfor b,c in sorted(rows,key=lambda x:x[0][0],reverse=True):print(f\\\"{b[0]:.3f} {c['customer_id']} {c['full_name']\"'!r} {c['\"'dob']} {c['nationality']} -> {b[1:]}\\\" )\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
