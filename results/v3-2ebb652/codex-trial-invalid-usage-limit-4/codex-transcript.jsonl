{"type":"item.started","item":{"id":"item_151","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport csv,json,re,difflib,sys\nsys.path.insert(0,'/app'); import screen\nes=json.load(open('/app/watchlist.json')); eng=screen.ScreeningEngine(es)\ndef cands(c):\n n=c['full_name']; t=c['type']; out=set()\n if t=='entity': out|=eng.entity_index.get(screen.organization_key(n),set())\n elif t=='vessel': out|=eng.vessel_index.get(screen.vessel_key(n),set())\n else:\n  for f,idx in [(screen.literal_signatures,eng.literal_index),(screen.western_signatures,eng.western_index),(lambda x:screen.arabic_signatures(x,eng.arabic_script_lexicon),eng.arabic_index),(screen.russian_signatures,eng.russian_index),(screen.chinese_signatures,eng.chinese_index)]:\n   for k in f(n): out|=idx.get(k,set())\n return out\ndef norm(s): return ''.join(sorted(x for x in screen.words(s) if len(x)>1))\nwn=[]\nfor e in es:\n if e['type']\"'!='\"'individual': continue\n for n in [e.get('primary_name','')]+[a['name'] for a in e.get('aliases',[]) if a['strength']=='strong']:\n  if n and re.search('[A-Za-z]',n): wn.append((str(e['uid']),str(n),norm(str(n))))\nrows=[]\nfor c in csv.DictReader(open('/app/customers.csv')):\n if c['type']\"'!='\"'individual' or eng.screen(c)[0]=='MATCH' or cands(c): continue\n nk=norm(c['full_name'])\n best=max((difflib.SequenceMatcher(None,nk,en).ratio(),uid,n) for uid,n,en in wn)\n if best[0]>=.78: rows.append((best,c))\nprint('no name candidate approximate >=.78',len(rows))\nfor b,c in sorted(rows,reverse=True,key=lambda x:x[0][0]):\n e=eng.entries[b[1]]\n print(f\\\"{b[0]:.3f} {c['customer_id']} {c['full_name']\"'!r} dob={c['\"'dob']} -> {b[1]} {b[2]\"'!r} dob={e.get('\"'dob')} nat={e.get('nationalities')}\\\")\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
