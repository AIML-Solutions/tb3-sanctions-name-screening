{"type":"item.started","item":{"id":"item_49","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport csv,json,screen,collections,difflib,re\nwl=json.load(open('watchlist.json')); pr={r['customer_id']:r for r in csv.DictReader(open('/tmp/decisions5.csv'))}; cs=list(csv.DictReader(open('customers.csv')))\nrt=collections.defaultdict(set)\nfor e in wl:\n if e['type']=='individual' and screen.has_cyrillic(e.get('script_name') or ''):\n  for n in [e['primary_name'],e.get('script_name') or '']+[a['name'] for a in e['aliases'] if a['strength']=='strong']:\n   for w in screen.words(n):\n    if len(w)>1 and not screen.is_patronymic(w): rt[screen.russian_token(w)].add(w)\nknown=set(rt)\nct=collections.Counter()\nfor c in cs:\n if c['type']=='individual' and pr[c['customer_id']]['decision']=='NO_MATCH' and (c['nationality'] in {'RU','UA','BY','KZ'} or re.search(r'(?i)(off|ow|wna|witsch|vitch|tsch|sch|cz|sz)',c['full_name'])):\n  for w in screen.words(c['full_name']):\n   if len(w)>1 and not screen.is_patronymic(w) and screen.russian_token(w) not in known:ct[w]+=1\nfor raw,n in ct.most_common():\n can=screen.russian_token(raw); near=difflib.get_close_matches(can,list(known),3,cutoff=.55)\n if n>1 or re.search(r'(off|ow|ew|ff|sch|cz|sz|ij|ja|wa|wo|ou|iy|ey)',raw): print(n,raw,'=>',can,'near',[(x,sorted(rt[x])[:3],round(difflib.SequenceMatcher(None,can,x).ratio(),2)) for x in near])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
