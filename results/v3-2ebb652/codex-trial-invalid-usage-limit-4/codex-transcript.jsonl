{"type":"item.started","item":{"id":"item_48","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport csv,json,screen,difflib,re\ncs=list(csv.DictReader(open('customers.csv'))); pr={r['customer_id']:r for r in csv.DictReader(open('/tmp/decisions5.csv'))}; wl=json.load(open('watchlist.json'))\nrus=[e for e in wl if e['type']=='individual' and screen.has_cyrillic(e.get('script_name') or '')]\ndef names(e):return [e['primary_name'],e.get('script_name') or '']+[a['name'] for a in e['aliases'] if a['strength']=='strong']\ndef key(n):\n t=[]\n for w in screen.words(n):\n  if len(w)>1 and not screen.is_patronymic(w): t.append(screen.russian_token(w,True))\n return '|'.join(sorted(t))\nout=[]\nfor c in cs:\n if c['type']\"'!='\"'individual' or pr[c['customer_id']]['decision']=='MATCH':continue\n # culture based only for diagnostic\n if c['nationality'] not in {'RU','UA','BY','KZ'} and not re.search(r'(?i)(off|ow|wna|witsch|vitch|tsch|sch|serguei|jou|iouri|sierg|cz|sz)',c['full_name']):continue\n ck=key(c['full_name'])\n for e in rus:\n  if not screen.date_compatible(c['dob'],e['dob']):continue\n  best=max((difflib.SequenceMatcher(None,ck,key(n)).ratio() for n in names(e)),default=0)\n  if best>=.68:out.append((best,c,e,ck,max(names(e),key=lambda n:difflib.SequenceMatcher(None,ck,key(n)).ratio())))\n# only top per customer\nbest={}\nfor x in out:\n if x[0]>best.get(x[1]['customer_id'],(-1,))[0]:best[x[1]['customer_id']]=x\nfor score,c,e,ck,n in sorted(best.values(),reverse=True,key=lambda x:x[0]): print(f\\\"{score:.3f} {c['customer_id']} {c['full_name']} [{c['dob']}] => {e['uid']} {e['primary_name']} [{e['dob']}] / {n}\\\")\nprint('n',len(best))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
