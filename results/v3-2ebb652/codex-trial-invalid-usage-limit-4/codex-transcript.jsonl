{"type":"item.started","item":{"id":"item_106","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport csv,json,screen,itertools\ncs=list(csv.DictReader(open('customers.csv')));p={r['customer_id']:r for r in csv.DictReader(open('/tmp/decisions13.csv'))};w=json.load(open('watchlist.json'))\ndef lev(a,b):\n d=list(range(len(b)+1))\n for i,x in enumerate(a,1):\n  z=[i]\n  for j,y in enumerate(b,1):z.append(min(z[-1]+1,d[j]+1,d[j-1]+int(x\"'!=y)))\n  d=z\n return d[-1]\nents=[]\nfor e in w:\n if e['\"'type']=='individual' and screen.has_cyrillic(e.get('script_name') or ''):\n  sig=set()\n  for n in [e['primary_name'],e.get('script_name') or '']+[a['name'] for a in e['aliases'] if a['strength']=='strong']:sig |= screen.russian_signatures(n)\n  ents.append((e,[tuple(x.split('|')) for x in sig]))\nout=[]\nfor c in cs:\n if c['type']\"'!='\"'individual' or p[c['customer_id']]['decision']=='MATCH' or c['nationality'] not in {'RU','UA','BY','KZ'}:continue\n ss=[tuple(x.split('|')) for x in screen.russian_signatures(c['full_name'])]\n best=None\n for e,es in ents:\n  if not screen.date_compatible(c['dob'],e['dob']):continue\n  for a in ss:\n   for b in es:\n    if len(a)\"'!=len(b):continue\n    costs=[lev(x,y) for x,y in zip(a,b)]; score=(sum(costs),max(costs),e,a,b)\n    if best is None or score[:2]<best[:2]:best=score\n if best and best[0]<=3 and best[1]<=2:out.append((best,c))\nfor (cost,mx,e,a,b),c in sorted(out,key=lambda x:x[0][:2]):print(cost,mx,c['\"'customer_id'],c['full_name'],c['dob'],a,'=>',e['uid'],e['primary_name'],e['dob'],b)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
