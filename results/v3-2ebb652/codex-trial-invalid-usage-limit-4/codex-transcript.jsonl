{"type":"item.started","item":{"id":"item_63","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport csv,screen,collections,difflib,re\npr={r['customer_id']:r for r in csv.DictReader(open('/tmp/decisions7.csv'))};cs=list(csv.DictReader(open('customers.csv')));ct=collections.Counter()\nfor c in cs:\n if c['type']=='individual' and pr[c['customer_id']]['decision']=='NO_MATCH' and (c['nationality'] in {'AF','IR','SY','EG','SA','IQ','JO','YE','LB','AE'} or re.search(r'(?i)(dsch|sch|ou|e\"'$)'\"',c['full_name'])):\n  for w in screen.words(c['full_name']):\n   if len(w)>1 and w not in screen.ARTICLES and w not in screen.NASAB and screen._arabic_semantic_lookup(w) is None:ct[w]+=1\nknown=list(screen.ARABIC_TOKEN_MAP)\nfor raw,n in ct.most_common():\n near=difflib.get_close_matches(raw,known,3,cutoff=.64)\n if n>=2 or re.search(r'(dsch|sch|e\"'$|y$|ie$)'\"',raw):print(n,raw,'near',[(x,screen.ARABIC_TOKEN_MAP[x],round(difflib.SequenceMatcher(None,raw,x).ratio(),2)) for x in near])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
