{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport csv,json,collections,difflib,re,unicodedata,screen\ncs=list(csv.DictReader(open('customers.csv'))); preds={r['customer_id']:r for r in csv.DictReader(open('decisions.csv'))}; wl=json.load(open('watchlist.json')); eng=screen.ScreeningEngine(wl)\nbydob=collections.defaultdict(list)\nfor e in wl:\n if e['type']=='individual' and e['dob']: bydob[e['dob']].append(e)\ndef latnames(e):\n ns=[e['primary_name']]+[a['name'] for a in e['aliases'] if a['strength']=='strong']\n return [x for x in ns if not screen.has_arabic(x) and not screen.has_cyrillic(x)] or ns\ndef rough(s):\n s=''.join(c for c in unicodedata.normalize('NFKD',s).lower() if unicodedata.category(c)\"'!='\"'Mn')\n return ''.join(re.findall('[a-z]+',s))\nfound=[]\nfor c in cs:\n if c['type']\"'!='\"'individual' or preds[c['customer_id']]['decision']=='MATCH' or len(c['dob'])\"'!=10: continue\n for e in bydob.get(c['\"'dob'],[]):\n  sims=[difflib.SequenceMatcher(None,rough(c['full_name']),rough(n)).ratio() for n in latnames(e)]\n  sim=max(sims,default=0)\n  found.append((sim,c,e,latnames(e)))\nfound.sort(key=lambda x:x[0],reverse=True)\nprint('unmatched individual exact-full-DOB pairs',len(found))\nfor sim,c,e,ns in found[:250]:\n print(f\\\"{sim:.3f} {c['customer_id']} {c['full_name']\"'!r} [{c['\"'dob']}] => {e['uid']} {e['primary_name']\"'!r} latin={ns} aliases={e['\"'aliases']}\\\")\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
