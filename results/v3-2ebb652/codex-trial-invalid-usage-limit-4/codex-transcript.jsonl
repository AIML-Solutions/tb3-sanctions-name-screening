{"type":"item.started","item":{"id":"item_39","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport csv,json,collections,difflib,re,unicodedata,screen\ncs=list(csv.DictReader(open('customers.csv'))); preds={r['customer_id']:r for r in csv.DictReader(open('/tmp/decisions4.csv'))}; wl=json.load(open('watchlist.json'))\nbydob=collections.defaultdict(list)\nfor e in wl:\n if e['type']=='individual' and len(e['dob'])==10: bydob[e['dob']].append(e)\ndef rough(s): return ''.join(re.findall('[a-z]+',screen.ascii_fold(s)))\ndef lats(e):\n ns=[e['primary_name']]+[a['name'] for a in e['aliases'] if a['strength']=='strong'];return [n for n in ns if all(ord(x)<128 for x in screen.ascii_fold(n))] or ns\nout=[]\nfor c in cs:\n if c['type']\"'!='\"'individual' or preds[c['customer_id']]['decision']=='MATCH' or len(c['dob'])\"'!=10:continue\n for e in bydob.get(c['\"'dob'],[]):\n  sim=max((difflib.SequenceMatcher(None,rough(c['full_name']),rough(n)).ratio() for n in lats(e)),default=0)\n  if sim>=.43:out.append((sim,c,e))\nfor sim,c,e in sorted(out,reverse=True,key=lambda x:x[0]): print(f\\\"{sim:.3f} {c['customer_id']} {c['full_name']} => {e['uid']} {e['primary_name']} {[a['name'] for a in e['aliases'] if a['strength']=='strong']}\\\")\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
