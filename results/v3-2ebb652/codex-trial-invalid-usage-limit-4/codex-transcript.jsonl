nt(f\\\"{b[0]:.3f} {c['customer_id']} {c['full_name']\"'!r} dob={c['\"'dob']} -> {b[1]} {b[2]\"'!r} dob={e.get('\"'dob')} nat={e.get('nationalities')}\\\")\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
