{"type":"item.started","item":{"id":"item_105","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport csv,json,screen,itertools,collections,re\ncs=list(csv.DictReader(open('customers.csv')));pred={r['customer_id']:r for r in csv.DictReader(open('/tmp/decisions13.csv'))};wl=json.load(open('watchlist.json'));eng=screen.ScreeningEngine(wl)\ndef lev(a,b):\n d=list(range(len(b)+1))\n for i,x in enumerate(a,1):\n  q=[i]\n  for j,y in enumerate(b,1):q.append(min(q[-1]+1,d[j]+1,d[j-1]+(x\"'!=y)))\n  d=q\n return d[-1]\ndef vals(name):\n out=[]\n for w in screen._arabic_core_words(name):\n  if screen.has_arabic(w):\n   x=eng.arabic_script_lexicon.get(w)\n   if not x:return []\n   out.append(sorted(x)[0])\n  else:\n   x=screen._arabic_semantic_lookup(w)\n   out.append(x or re.sub('\"'[\"'^a-z]'\"','',screen.ascii_fold(w)))\n return out\nentries=[]\nfor e in wl:\n if e['type']\"'!='\"'individual' or not screen.has_arabic(e.get('script_name') or ''):continue\n for n in [e['primary_name']]+[a['name'] for a in e['aliases'] if a['strength']=='strong']:\n  v=vals(n)\n  if len(v)>=2:entries.append((e,v,n))\nbest={}\nfor c in cs:\n if c['type']\"'!='\"'individual' or pred[c['customer_id']]['decision']=='MATCH':continue\n if c['nationality'] not in {'AF','IR','SY','EG','SA','IQ','JO','YE','LB','AE'}:continue\n cv=vals(c['full_name'])\n if not 2<=len(cv)<=3:continue\n for e,ev,n in entries:\n  if len(ev)\"'!=len(cv) or not screen.date_compatible(c['\"'dob'],e['dob']):continue\n  cost=min(sum(lev(a,b) for a,b in zip(cv,p)) for p in itertools.permutations(ev))\n  mx=min(max(lev(a,b) for a,b in zip(cv,p)) for p in itertools.permutations(ev))\n  score=(cost,mx)\n  old=best.get(c['customer_id'])\n  if old is None or score<old[:2]:best[c['customer_id']]=(cost,mx,c,e,cv,ev,n)\nfor cost,mx,c,e,cv,ev,n in sorted(best.values(),key=lambda x:(x[0],x[1])):\n if cost<=4 and mx<=3:print(cost,mx,c['customer_id'],c['full_name'],c['dob'],cv,'=>',e['uid'],n,e['dob'],ev)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
