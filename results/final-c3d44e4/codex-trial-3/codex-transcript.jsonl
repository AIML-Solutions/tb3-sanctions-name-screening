{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"wc -l customers.csv dev/customers_dev.csv dev/labels_dev.csv screen.py; sed -n '1,260p' screen.py; python3 - <<'PY'\nimport csv,json,collections\nwith open('watchlist.json') as f: w=json.load(f)\nprint('watchlist',len(w),collections.Counter(x['type'] for x in w))\nprint('original-only',sum(all(ord(c)<128 for c in x['primary_name'])==False and not any(any(ord(c)<128 for c in a['name']) for a in x['aliases']) for x in w))\nfor typ in ('individual','entity','vessel'):\n print('\\\\n##',typ)\n for x in w:\n  if x['type']==typ:\n   print(x['uid'],'|',x['primary_name'],'| script=',x.get('script_name'),'| dob=',x.get('dob'),'| aliases=',[(a['name'],a['strength']) for a in x['aliases']], '| ids=',[(i['type'],i['number']) for i in x['ids']])\nprint('\\\\nclasses')\nwith open('dev/labels_dev.csv') as f: print(collections.Counter(r['class'] for r in csv.DictReader(f)))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
