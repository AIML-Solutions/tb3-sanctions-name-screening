{"type":"item.started","item":{"id":"item_100","type":"command_execution","command":"/bin/bash -lc \"python3 screen.py --watchlist watchlist.json --customers customers.csv --out decisions.csv && python3 - <<'PY'\nimport csv,json,importlib.util,collections\nsp=importlib.util.spec_from_file_location('s','screen.py');s=importlib.util.module_from_spec(sp);sp.loader.exec_module(s);W=json.load(open('watchlist.json'));by={e['uid']:e for e in W};eng=s.Engine(W)\nC={r['customer_id']:r for r in csv.DictReader(open('customers.csv'))};O={r['customer_id']:r for r in csv.DictReader(open('decisions.csv'))};forms=[(f,u) for f,us in eng.individual.items() for u in us]\ndef lev(a,b):\n p=list(range(len(b)+1))\n for i,x in enumerate(a,1):\n  q=[i]\n  for j,y in enumerate(b,1):q.append(min(q[-1]+1,p[j]+1,p[j-1]+(x\"'!=y)))\n  p=q\n return p[-1]\nrows=[];ct=set();wt={x for f,u in forms for x in f}\nfor cid,c in C.items():\n if c['\"'type']=='individual' and O[cid]['decision']=='NO_MATCH' and not c['dob']:\n  cf=s.individual_forms(c['full_name']);rows.append((cid,c,cf));ct.update(x for f in cf for x in f)\nD={(a,b):lev(a,b) for a in ct for b in wt}\nres=[]\nfor cid,c,cf in rows:\n best=(99,None,None,None)\n for f,u in forms:\n  for z in cf:\n   d=D[z[0],f[0]]+D[z[1],f[1]]\n   if d<best[0]:best=(d,f,u,z)\n if best[0]<=4:res.append((best[0],cid,c['full_name'],best[2],by[best[2]]['primary_name'],by[best[2]]['dob'],best[3],best[1]))\nprint('rows',len(rows),'dist',collections.Counter(x[0] for x in res))\nfor x in sorted(res):print(x)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
