{"type":"item.started","item":{"id":"item_47","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport csv,json,importlib.util,collections\nsp=importlib.util.spec_from_file_location('s','screen.py');s=importlib.util.module_from_spec(sp);sp.loader.exec_module(s)\nW=json.load(open('watchlist.json')); by={e['uid']:e for e in W}; eng=s.Engine(W)\nC={r['customer_id']:r for r in csv.DictReader(open('customers.csv'))};O={r['customer_id']:r for r in csv.DictReader(open('decisions.csv'))}\nforms=[]\nfor form,uids in eng.individual.items():\n for u in uids: forms.append((form,u))\ndef lev(a,b):\n p=list(range(len(b)+1))\n for i,x in enumerate(a,1):\n  q=[i]\n  for j,y in enumerate(b,1):q.append(min(q[-1]+1,p[j]+1,p[j-1]+(x\"'!=y)))\n  p=q\n return p[-1]\nres=[];pairs=collections.Counter()\nfor cid,c in C.items():\n if c['\"'type']\"'!='\"'individual' or O[cid]['decision']\"'!='\"'NO_MATCH':continue\n cf=s.individual_forms(c['full_name'])\n if not cf:continue\n best=None\n for f,u in forms:\n  e=by[u]\n  if not s.dob_compatible(c['dob'],str(e.get('dob',''))):continue\n  d=lev(next(iter(cf))[0],f[0])+lev(next(iter(cf))[1],f[1])\n  # all cf already both orientations; calculate proper min\n  d=min(lev(a,f[0])+lev(b,f[1]) for a,b in cf)\n  score=(d,u)\n  if best is None or score<best[0]:best=(score,f,u)\n if best and best[0][0]<=4:\n  d=best[0][0];f=best[1];u=best[2];\n  # select aligned c form\n  a,b=min(cf,key=lambda z:lev(z[0],f[0])+lev(z[1],f[1]))\n  if a\"'!=f[0]:pairs[(a,f[0])]+=1\n  if b!=f[1]:pairs[(b,f[1])]+=1\n  res.append((d,cid,c['\"'full_name'],c['dob'],u,by[u]['primary_name'],by[u]['dob'],(a,b),f))\nprint('near compatible unmatched',collections.Counter(x[0] for x in res))\nprint('\\\\nPAIR COUNTS')\nfor x,n in pairs.most_common(160):print(n,x)\nprint('\\\\nDIST <=2 DETAILS',sum(x[0]<=2 for x in res))\nfor x in sorted(res)[:300]:\n if x[0]<=2: print(x)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
