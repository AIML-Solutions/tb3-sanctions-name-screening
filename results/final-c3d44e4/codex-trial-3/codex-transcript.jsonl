{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json,importlib.util,re,collections\nsp=importlib.util.spec_from_file_location('s','screen.py');s=importlib.util.module_from_spec(sp);sp.loader.exec_module(s)\nW=json.load(open('watchlist.json'))\nSCI={'а':'a','б':'b','в':'v','г':'g','д':'d','е':'e','ё':'e','ж':'z','з':'z','и':'i','й':'j','к':'k','л':'l','м':'m','н':'n','о':'o','п':'p','р':'r','с':'s','т':'t','у':'u','ф':'f','х':'h','ц':'c','ч':'c','ш':'s','щ':'sc','ъ':'','ы':'y','ь':'','э':'e','ю':'ju','я':'ja'}\nPOL={'а':'a','б':'b','в':'w','г':'g','д':'d','е':'e','ё':'io','ж':'z','з':'z','и':'i','й':'j','к':'k','л':'l','м':'m','н':'n','о':'o','п':'p','р':'r','с':'s','т':'t','у':'u','ф':'f','х':'ch','ц':'c','ч':'cz','ш':'sz','щ':'szcz','ъ':'','ы':'y','ь':'','э':'e','ю':'ju','я':'ja'}\ndef tr(x,m):return ''.join(m.get(c,c) for c in x.lower())\nfor label,m in [('SCI',SCI),('POL',POL)]:\n fail=collections.Counter(); examples=[]; total=0\n for e in W:\n  sn=e.get('script_name') or ''\n  if e['type']\"'!='\"'individual' or not re.search('[а-яё]',sn.lower()):continue\n  total+=1; v=tr(sn,m)\n  if not (s.individual_forms(v)&s.individual_forms(sn)):\n   # collect endpoint raw canonical pairs\n   f1=s.individual_forms(v);f2=s.individual_forms(sn)\n   fail[(tuple(sorted(f1)),tuple(sorted(f2)))]+=1\n   if len(examples)<80: examples.append((v,e['primary_name'],s.name_tokens(v),s.name_tokens(sn)))\n print('\\\\n',label,'total',total,'fails',sum(fail.values()))\n for x in examples:print(x)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
