{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json,re,collections,unicodedata\nW=json.load(open('watchlist.json'))\ndef script(s):\n if re.search(r'[\\\\u0400-\\\\u04ff]',s): return 'cyr'\n if re.search(r'[\\\\u0600-\\\\u06ff]',s): return 'arab'\n return 'latin'\nfor sc in ['latin','cyr','arab']:\n seq=[]; toks=collections.Counter()\n for e in W:\n  if e['type']=='individual' and script(e['primary_name'])==sc:\n   seq.append(e['primary_name'])\n   toks.update(re.findall(r\\\"[\"'^'\"\\\\W\\\\d_]+\\\",e['primary_name'].lower(),re.UNICODE))\n print(sc,'names',len(seq),'unique toks',len(toks))\n print('TOKENS:', ' '.join(sorted(toks)))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
