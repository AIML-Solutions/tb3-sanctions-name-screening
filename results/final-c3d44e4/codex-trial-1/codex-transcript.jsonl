{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json,re,unicodedata,collections\nw=json.load(open('/app/watchlist.json'))\ndef lat(s):\n s=unicodedata.normalize('NFKD',s);s=''.join(c for c in s if not unicodedata.combining(c)).lower();raw=re.findall(r'[a-z]+',s)\n out=[]\n for x in raw:\n  if x in ('al','el'):continue\n  if x in ('abdollah','abdoollah'):x='abdullah'\n  if x.startswith('nasrall'):x='nasrallah'\n  out.append(x)\n return out\ndef scr(s):\n s=unicodedata.normalize('NFKC',s);s=''.join(c for c in s if unicodedata.category(c) not in ('Mn','Cf'))\n s=s.translate(str.maketrans({'أ':'ا','إ':'ا','آ':'ا','ٱ':'ا','ى':'ي','ئ':'ي','ؤ':'و','ة':'ه','ک':'ك','ی':'ي','ۀ':'ه'}))\n raw=[]\n for x in s.split():\n  if x=='الله':raw.append(x)\n  elif x.startswith('ال') and len(x)>2:raw.append(x[2:])\n  else:raw.append(x)\n out=[];i=0\n while i<len(raw):\n  if i+1<len(raw) and raw[i]=='عبد' and raw[i+1]=='الله':out.append('عبدالله');i+=2\n  elif i+1<len(raw) and raw[i]=='نصر' and raw[i+1]=='الله':out.append('نصرالله');i+=2\n  else:out.append(raw[i]);i+=1\n return out\nmp=collections.defaultdict(collections.Counter);mis=[]\nfor e in w:\n p=e['primary_name'];s=e.get('script_name')\n if not s or any(ord(c)>127 for c in p):continue\n a=lat(p);b=scr(s)\n if len(a)==len(b):\n  for x,y in zip(b,a):mp[x][y]+=1\n else:mis.append((p,s,a,b))\nprint('aligned',763-len(mis),'mis',len(mis),'maps',len(mp))\nfor x in mis[:40]:print(x)\norig=[]\nfor e in w:\n if e['type']=='individual' and any(ord(c)>127 for c in e['primary_name']):\n  mm=[x for x in scr(e['primary_name']) if x not in mp]\n  if mm:orig.append((e['primary_name'],mm))\nprint('missing',len(orig));print(*orig,sep='\\\\n')\nprint('ambig',[(k,v) for k,v in mp.items() if len(v)>1])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
