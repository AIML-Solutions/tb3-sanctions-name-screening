{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json,re,collections\nw=json.load(open('/app/watchlist.json'))\nfor culture, pred in [\n ('arabic', lambda s:any('\\\\u0600'<=c<='\\\\u06ff' for c in s) and not any(c in s for c in 'پچژگک')),\n ('persian', lambda s:any(c in s for c in 'پچژگک')),\n ('cyrillic', lambda s:any('\\\\u0400'<=c<='\\\\u04ff' for c in s)),\n ('western', lambda s:not any(ord(c)>127 for c in s))]:\n toks=collections.Counter()\n names=[]\n for e in w:\n  if e['type']\"'!='\"'individual':continue\n  s=e.get('script_name') or ''\n  if culture=='western':\n   if s: continue\n  elif not pred(s):continue\n  p=e['primary_name']\n  if any(ord(c)>127 for c in p):continue\n  names.append(p)\n  toks.update(re.findall(r\\\"[A-Za-z]+\\\",p))\n print('\\\\n##',culture,'latin-primary names',len(names))\n print('TOKENS:', ' '.join(sorted(toks, key=str.lower)))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
