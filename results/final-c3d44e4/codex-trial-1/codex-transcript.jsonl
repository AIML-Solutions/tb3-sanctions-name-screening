{"type":"item.started","item":{"id":"item_53","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport csv,json,re,unicodedata,difflib,importlib.util\ns=importlib.util.spec_from_file_location('s','/app/screen.py');m=importlib.util.module_from_spec(s);s.loader.exec_module(m)\nw=json.load(open('/app/watchlist.json')); eng=m.ScreeningEngine(w)\np={x['customer_id']:x for x in csv.DictReader(open('/tmp/batch_predictions.csv'))}; cs=list(csv.DictReader(open('/app/customers.csv')))\n\ndef norm(s):\n t=eng.tokens(s); t=[eng.uf.find(x) for x in t if len(x)>1 and x not in m.NASAB]\n return ' '.join(sorted(t))\nvars=[]\nfor e in w:\n if e['type']\"'!='\"'individual':continue\n for n in [e['primary_name']]+[a['name'] for a in e['aliases'] if a['strength']=='strong']:\n  vars.append((norm(n),e,n))\nrows=[]\nfor c in cs:\n if c['type']\"'!='\"'individual' or p[c['customer_id']]['decision']=='MATCH':continue\n cn=norm(c['full_name']); best=None\n for en,e,n in vars:\n  if not m.dob_compatible(c['dob'],e['dob']):continue\n  sc=difflib.SequenceMatcher(None,cn,en).ratio()\n  if best is None or sc>best[0]:best=(sc,e,n,en)\n if best and (best[0]>=.88 or (best[0]>=.74 and c['dob'] and best[1]['dob'] and m.dob_support(c['dob'],best[1]['dob']))):\n  rows.append((best[0],c,best))\nrows.sort(key=lambda z:-z[0])\nprint('diagnostic candidates',len(rows))\nfor sc,c,(_,e,n,en) in rows[:350]:\n print(f\\\"{sc:.3f} {c['customer_id']} {c['full_name']\"'!r} dob={c['\"'dob']}  ~ {e['uid']} {n\"'!r} dob={e['\"'dob']} | {norm(c['full_name'])\"'!r} / {en!r}\")\nPY'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
