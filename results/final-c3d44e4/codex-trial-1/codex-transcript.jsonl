{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport csv,json\nw=json.load(open('/app/watchlist.json')); by={x['uid']:x for x in w}; cs={x['customer_id']:x for x in csv.DictReader(open('/app/dev/customers_dev.csv'))}; ls=list(csv.DictReader(open('/app/dev/labels_dev.csv')))\n# naive nearest via SequenceMatcher over names for context\nfrom difflib import SequenceMatcher\nfor cls in ['D2_near_name','D6_same_given','D4_entity_near_name','D1_name_dob_conflict','D5_partial_dob_conflict']:\n print('\\\\n###',cls)\n for z in [q for q in ls if q['class']==cls][:120]:\n  c=cs[z['customer_id']]\n  candidates=[e for e in w if e['type']==c['type']]\n  e=max(candidates,key=lambda x:SequenceMatcher(None,c['full_name'].lower(),x['primary_name'].lower()).ratio())\n  print(repr(c['full_name']),c['dob'],'~',repr(e['primary_name']),e['uid'],e['dob'],round(SequenceMatcher(None,c['full_name'].lower(),e['primary_name'].lower()).ratio(),2))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
