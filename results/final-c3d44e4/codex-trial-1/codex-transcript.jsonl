{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json,re,unicodedata,collections\nw=json.load(open('/app/watchlist.json'))\ndef lat(s):\n s=unicodedata.normalize('NFKD',s)\n s=''.join(c for c in s if not unicodedata.combining(c)).lower()\n t=re.findall(r\\\"[a-z]+\\\",s.replace('’',\\\"'\\\"))\n out=[]\n for x in t:\n  if x in ('abdullah','abdollah','abdoollah'): out += ['abd','allah']\n  elif x.startswith('nasrall'): out += ['nasr','allah']\n  elif x.startswith('al') and x not in ('ali','alim') and len(x)>4: out += ['al',x[2:]]\n  else: out.append(x)\n return out\ndef scr(s):\n s=unicodedata.normalize('NFKC',s)\n s=''.join(c for c in s if unicodedata.category(c) not in ('Mn','Cf'))\n s=s.translate(str.maketrans({'أ':'ا','إ':'ا','آ':'ا','ٱ':'ا','ى':'ي','ئ':'ي','ؤ':'و','ة':'ه','ک':'ك','ی':'ي','ۀ':'ه'}))\n out=[]\n for x in s.split():\n  if x.startswith('ال') and len(x)>2: out += ['ال',x[2:]]\n  else: out.append(x)\n return out\nmp=collections.defaultdict(collections.Counter)\nmatch=0; mismatch=[]\nfor e in w:\n p=e['primary_name']; s=e.get('script_name')\n if not s or any(ord(c)>127 for c in p):continue\n a=lat(p); b=scr(s)\n if len(a)==len(b):\n  match+=1\n  for x,y in zip(b,a):mp[x][y]+=1\n else:mismatch.append((p,s,a,b))\nprint('aligned',match,'mismatch',len(mismatch),'mapped script toks',len(mp))\nprint('mismatch sample')\nfor x in mismatch[:50]:print(x)\norig=[]\nfor e in w:\n if e['type']=='individual' and any(ord(c)>127 for c in e['primary_name']):\n  missing=[x for x in scr(e['primary_name']) if x not in mp]\n  if missing:orig.append((e['primary_name'],missing))\nprint('original only entries with missing',len(orig),'of',sum(e['type']=='individual' and any(ord(c)>127 for c in e['primary_name']) for e in w))\nfor x in orig[:60]:print(x)\nprint('ambiguous maps')\nfor k,v in mp.items():\n if len(v)>1:print(k,v)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
