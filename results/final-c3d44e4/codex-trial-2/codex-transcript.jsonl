{"type":"item.started","item":{"id":"item_102","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport csv,json,screen,difflib,collections\nW=json.load(open('watchlist.json'));S=screen.Screener(W);C=list(csv.DictReader(open('customers.csv')));P={x['customer_id']:x for x in csv.DictReader(open('decisions.csv'))}\nidx=collections.defaultdict(list)\nfor e in W:\n if e['type']=='individual':\n  for k,wk in S.prepared[e['uid']]:\n   if not wk and len(k)==2:\n    for t in k:idx[t].append((e,k))\npairs=collections.defaultdict(list)\nfor c in C:\n if P[c['customer_id']]['decision']\"'!='\"'NO_MATCH' or c['type']\"'!='\"'individual':continue\n ck=screen.person_key(c['full_name'],S.script_lexicon)\n if len(ck)\"'!=2:continue\n for shared in ck:\n  otherc=ck[1] if ck[0]==shared else ck[0]\n  for e,k in idx[shared]:\n   if not screen.dob_compatible(c['\"'dob'],e['dob']):continue\n   othert=k[1] if k[0]==shared else k[0]\n   if otherc==othert:continue\n   rat=difflib.SequenceMatcher(None,otherc,othert).ratio()\n   if rat>=.6:pairs[(otherc,othert)].append((rat,c['customer_id'],c['full_name'],c['dob'],e['uid'],e['primary_name'],e['dob'],shared))\nfor key,v in sorted(pairs.items(),key=lambda z:(-max(x[0] for x in z[1]),-len(z[1]),z[0])):\n rat=max(x[0] for x in v)\n if rat<.75:continue\n print('\\\\n',key,'ratio',rat,'n',len(v))\n for x in v[:5]:print(' ',x[1:])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
