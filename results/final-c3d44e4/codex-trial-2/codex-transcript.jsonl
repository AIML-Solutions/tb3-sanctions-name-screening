{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport csv,json,re,unicodedata,difflib\nW=json.load(open('watchlist.json')); C={r['customer_id']:r for r in csv.DictReader(open('dev/customers_dev.csv'))}; L=list(csv.DictReader(open('dev/labels_dev.csv')))\ndef n(s):\n s=''.join(c for c in unicodedata.normalize('NFKD',s.lower()) if not unicodedata.combining(c))\n return ' '.join(re.findall('[a-z]+',s))\ndef score(a,b):\n aa=n(a);bb=n(b)\n x=difflib.SequenceMatcher(None,aa,bb).ratio()\n y=difflib.SequenceMatcher(None,' '.join(sorted(aa.split())),' '.join(sorted(bb.split()))).ratio()\n return max(x,y)\nfor cls in ['D1_name_dob_conflict','D2_near_name','D4_entity_near_name','D5_partial_dob_conflict','D6_same_given']:\n print('\\\\n###',cls)\n for z in [q for q in L if q['class']==cls][:40]:\n  c=C[z['customer_id']]; candidates=[e for e in W if e['type']==c['type']]\n  best=[]\n  for e in candidates:\n   for name in [e['primary_name']]+[a['name'] for a in e['aliases'] if a['strength']=='strong']:\n    best.append((score(c['full_name'],name),e['uid'],name,e['dob']))\n  best=sorted(best,reverse=True)[:2]\n  print(repr(c['full_name']),c['dob'],'::',best)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
