{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json,re,collections,csv,unicodedata\nw=json.load(open('watchlist.json'))\nfor typ in ('individual','entity','vessel'):\n a=[x for x in w if x['type']==typ]\n print('\\\\n',typ,len(a),'strong aliases',sum(sum(z['strength']=='strong' for z in x['aliases']) for x in a),'weak',sum(sum(z['strength']=='weak' for z in x['aliases']) for x in a))\n print('\\\\n'.join(x['primary_name'] for x in a[:30]))\n# Latin primary individual token frequency unique sorted\nnames=[]\nfor x in w:\n if x['type']=='individual':\n  for field in [x['primary_name']]+[a['name'] for a in x['aliases'] if a['strength']=='strong']:\n   if all(ord(c)<128 for c in field): names += re.findall(\\\"[A-Za-z]+\\\",field)\nprint('\\\\nLatin individual tokens',len(set(n.lower() for n in names)))\nprint(' '.join(sorted(set(n.lower() for n in names))))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
