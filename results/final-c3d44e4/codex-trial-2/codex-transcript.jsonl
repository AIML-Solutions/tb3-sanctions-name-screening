{"type":"item.started","item":{"id":"item_82","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport csv,json,screen,difflib,collections\nW=json.load(open('watchlist.json'));S=screen.Screener(W);C=list(csv.DictReader(open('customers.csv')));P={x['customer_id']:x for x in csv.DictReader(open('/tmp/decisions_current4.csv'))};idx=collections.defaultdict(list)\nfor e in W:\n if e['type']=='individual':\n  for k,wk in S.prepared[e['uid']]:\n   if not wk and len(k)==2:\n    for t in k:idx[t].append((e,k))\ndef st(a,b):return difflib.SequenceMatcher(None,a,b).ratio()\ndef sc(a,b):return max((st(a[0],b[0])+st(a[1],b[1]))/2,(st(a[0],b[1])+st(a[1],b[0]))/2)\nr=[]\nfor c in C:\n if P[c['customer_id']]['decision']\"'!='\"'NO_MATCH' or c['type']\"'!='\"'individual':continue\n ck=screen.person_key(c['full_name'],S.script_lexicon)\n if len(ck)\"'!=2:continue\n cand=[];seen=set()\n for t in ck:\n  for e,k in idx[t]:\n   if (e['\"'uid'],k) in seen:continue\n   seen.add((e['uid'],k))\n   if screen.dob_compatible(c['dob'],e['dob']):cand.append((sc(ck,k),e,k))\n if cand:\n  q=max(cand,key=lambda x:x[0])\n  if q[0]>=.87:r.append((q[0],c['customer_id'],c['full_name'],c['dob'],ck,q[1]['uid'],q[1]['primary_name'],q[1]['dob'],q[2]))\nfor x in sorted(r,reverse=True):print(x)\nprint('count',len(r))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
