{"type":"item.completed","item":{"id":"item_73","type":"command_execution","command":"/bin/bash -lc \"python3 screen.py --watchlist watchlist.json --customers customers.csv --out /tmp/decisions_current3.csv && python3 - <<'PY'\nimport csv,json,screen,difflib\nW=json.load(open('watchlist.json'));S=screen.Screener(W);C=list(csv.DictReader(open('customers.csv')));P={x['customer_id']:x for x in csv.DictReader(open('/tmp/decisions_current3.csv'))}\ndef st(a,b):return difflib.SequenceMatcher(None,a,b).ratio()\ndef sc(a,b):\n if len(a)\"'!=len(b) or len(a)!=2:return 0\n return max((st(a[0],b[0])+st(a[1],b[1]))/2,(st(a[0],b[1])+st(a[1],b[0]))/2)\nr=[]\nfor c in C:\n if P[c['\"'customer_id']]['decision']\"'!='\"'NO_MATCH' or c['type']\"'!='\"'individual':continue\n ck=screen.person_key(c['full_name'],S.script_lexicon)\n if len(ck)\"'!=2:continue\n best=[]\n for e in W:\n  if e['\"'type']\"'!='\"'individual' or not screen.dob_compatible(c['dob'],e['dob']):continue\n  for k,wk in S.prepared[e['uid']]:\n   if not wk and len(k)==2:\n    q=sc(ck,k)\n    if q>=.82:best.append((q,e,k))\n if best:\n  q=max(best,key=lambda x:x[0]);r.append((q[0],c['customer_id'],c['full_name'],c['dob'],ck,q[1]['uid'],q[1]['primary_name'],q[1]['dob'],q[2]))\nfor x in sorted(r,reverse=True):print(x)\nprint('count',len(r))\nPY\"","aggregated_output":"(0.9736842105263157, 'C288706', 'Timur Tkazchenko', '1950-01', ('timur', 'tkazchenko'), 'SDN-76529', 'Timur Tkachenko', '1950-01-20', ('timur', 'tkachenko'))\n(0.9705882352941176, 'C749055', 'Mortezah Tabreezi', '1993', ('mortezah', 'tabrizi'), 'SDN-93500', 'مرتضی تبریزی', '1993', ('mortezahe', 'tabrizi'))\n(0.9705882352941176, 'C567572', 'Lyoudmila Mikhailovna Tchernova', '', ('chernov', 'lyoudmila'), 'SDN-48839', 'Людмила Михайловна Чернова', '', ('chernov', 'lyudmila'))\n(0.9666666666666667, 'C843532', 'Alekseiy Tsvetkov', '', ('alekseiy', 'tsvetkov'), 'SDN-90849', 'Aleksei Tsvetkov', '1990-11-25', ('aleksei', 'tsvetkov'))\n(0.9666666666666667, 'C814682'