{"type":"item.started","item":{"id":"item_70","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport csv,json,screen,difflib\nW=json.load(open('watchlist.json')); S=screen.Screener(W); C=list(csv.DictReader(open('customers.csv'))); P={x['customer_id']:x for x in csv.DictReader(open('/tmp/decisions_current2.csv'))}\nbydob={}\nfor e in W:\n if e['type']=='individual' and e.get('dob'): bydob.setdefault(e['dob'],[]).append(e)\ndef st(a,b):return difflib.SequenceMatcher(None,a,b).ratio()\ndef sc(a,b):\n if len(a)\"'!=len(b) or not a:return 0\n if len(a)==2:return max((st(a[0],b[0])+st(a[1],b[1]))/2,(st(a[0],b[1])+st(a[1],b[0]))/2)\n return difflib.SequenceMatcher(None,'\"' '.join(a),' '.join(b)).ratio()\nr=[]\nfor c in C:\n if P[c['customer_id']]['decision']\"'!='\"'NO_MATCH' or c['type']\"'!='\"'individual' or len(c['dob'])\"'!=10:continue\n ck=screen.person_key(c['\"'full_name'],S.script_lexicon);best=None\n for e in bydob.get(c['dob'],[]):\n  for k,wk in S.prepared[e['uid']]:\n   if not wk:\n    q=(sc(ck,k),e,k)\n    if best is None or q[0]>best[0]:best=q\n if best and best[0]>=.7:r.append((best[0],c['customer_id'],c['full_name'],ck,best[1]['uid'],best[1]['primary_name'],best[2]))\nfor x in sorted(r,reverse=True):print(x)\nprint('count',len(r))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
