{"type":"item.started","item":{"id":"item_73","type":"command_execution","command":"/bin/bash -lc \"python3 screen.py --watchlist watchlist.json --customers customers.csv --out /tmp/decisions_current3.csv && python3 - <<'PY'\nimport csv,json,screen,difflib\nW=json.load(open('watchlist.json'));S=screen.Screener(W);C=list(csv.DictReader(open('customers.csv')));P={x['customer_id']:x for x in csv.DictReader(open('/tmp/decisions_current3.csv'))}\ndef st(a,b):return difflib.SequenceMatcher(None,a,b).ratio()\ndef sc(a,b):\n if len(a)\"'!=len(b) or len(a)!=2:return 0\n return max((st(a[0],b[0])+st(a[1],b[1]))/2,(st(a[0],b[1])+st(a[1],b[0]))/2)\nr=[]\nfor c in C:\n if P[c['\"'customer_id']]['decision']\"'!='\"'NO_MATCH' or c['type']\"'!='\"'individual':continue\n ck=screen.person_key(c['full_name'],S.script_lexicon)\n if len(ck)\"'!=2:continue\n best=[]\n for e in W:\n  if e['\"'type']\"'!='\"'individual' or not screen.dob_compatible(c['dob'],e['dob']):continue\n  for k,wk in S.prepared[e['uid']]:\n   if not wk and len(k)==2:\n    q=sc(ck,k)\n    if q>=.82:best.append((q,e,k))\n if best:\n  q=max(best,key=lambda x:x[0]);r.append((q[0],c['customer_id'],c['full_name'],c['dob'],ck,q[1]['uid'],q[1]['primary_name'],q[1]['dob'],q[2]))\nfor x in sorted(r,reverse=True):print(x)\nprint('count',len(r))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.started","item":{"id":"item_74","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport csv,json,screen,difflib,collections\nW=json.load(open('watchlist.json'));S=screen.Screener(W);C=list(csv.DictReader(open('customers.csv')));P={x['customer_id']:x for x in csv.DictReader(open('/tmp/decisions_current3.csv'))}\nidx=collections.defaultdict(list)\nfor e in W:\n if e['type']=='individual':\n  for k,wk in S.prepared[e['uid']]:\n   if not wk and len(k)==2:\n    for t in k:idx[t].append((e,k))\ndef st(a,b):return difflib.SequenceMatcher(None,a,b).ratio()\ndef sc(a,b):return max((st(a[0],b[0])+st(a[1],b[1]))/2,(st(a[0],b[1])+st(a[1],b[0]))/2)\nr=[]\nfor c in C:\n if P[c['customer_id']]['decision']\"'!='\"'NO_MATCH' or c['type']\"'!='\"'individual':continue\n ck=screen.person_key(c['full_name'],S.script_lexicon)\n if len(ck)\"'!=2:continue\n cand=[];seen=set()\n for t in ck:\n  for e,k in idx[t]:\n   z=(e['\"'uid'],k)\n   if z in seen:continue\n   seen.add(z)\n   if screen.dob_compatible(c['dob'],e['dob']):cand.append((sc(ck,k),e,k))\n if cand:\n  q=max(cand,key=lambda x:x[0])\n  if q[0]>=.82:r.append((q[0],c['customer_id'],c['full_name'],c['dob'],ck,q[1]['uid'],q[1]['primary_name'],q[1]['dob'],q[2]))\nfor x in sorted(r,reverse=True):print(x)\nprint('count',len(r))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
