n Holdings LLC'),('Hsieh Metals','Xie Metals FZE'),('Wong Maritime','Huang Maritime SA')]\nentity_ok=sum(screen.entity_keys_equal(screen.entity_key(a),screen.entity_key(b)) for a,b in entity_pairs)\ndistinct=(screen.person_key('Hassan Mansour',S.script_lexicon)\"'!=screen.person_key('\"'Hussein Mansour',S.script_lexicon) and screen.person_key('Sami Saleh',S.script_lexicon)\"'!=screen.person_key('\"'Samir Saleh',S.script_lexicon) and screen.person_key('Zainab Faris',S.script_lexicon)\"'!=screen.person_key('\"'Zainab Farsi',S.script_lexicon))\nprint('explicit pairs',len(pairs)-len(failed),'/',len(pairs),'failures',failed)\nprint('scientific Cyrillic',sci_ok,'/',sci_total)\nprint('Chinese systems',entity_ok,'/',len(entity_pairs))\nprint('required lookalikes distinct',distinct)\nPY\n/usr/bin/time -f 'runtime_seconds=%e max_rss_kb=%M' python3 screen.py --watchlist watchlist.json --customers customers.csv --out decisions.csv\npython3 - <<'PY'\nimport csv,collections\ncustomers=list(csv.DictReader(open('customers.csv',encoding='utf-8-sig')))\nwith open('decisions.csv',encoding='utf-8',newline='') as f:\n r=csv.reader(f); header=next(r); raw=list(r)\nrows=list(csv.DictReader(open('decisions.csv',encoding='utf-8')))\nids=[x['customer_id'] for x in rows]\nprint('header',header)\nprint('rows',len(rows),'customers',len(customers),'unique_ids',len(set(ids)))\nprint('decisions',collections.Counter(x['decision'] for x in rows))\nprint('invalid',sum(x['decision'] not in {'MATCH','NO_MATCH'} or (x['decision']=='NO_MATCH' and x['matched_uid']) or (x['decision']=='MATCH' and not x['matched_uid']) for x in rows))\nprint('order_ok',ids==[x['customer_id'] for x in customers])\nPY\nsha256sum screen.py decisions.csv\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
