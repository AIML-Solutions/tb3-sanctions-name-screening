{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport csv,json,collections,screen\nW={x['uid']:x for x in json.load(open('watchlist.json'))}; wl=list(W.values()); s=screen.Screener(wl)\nC={x['customer_id']:x for x in csv.DictReader(open('dev/customers_dev.csv'))}\nP={x['customer_id']:x for x in csv.DictReader(open('/tmp/dev_pred.csv'))}\nfor z in csv.DictReader(open('dev/labels_dev.csv')):\n p=P[z['customer_id']]\n if z['expected_decision']=='MATCH' and p['decision']=='NO_MATCH':\n  c=C[z['customer_id']]; e=W[z['expected_uid']]\n  names=[e['primary_name']]+[a['name'] for a in e['aliases'] if a['strength']=='strong']\n  print('\\\\n',z['class'],z['customer_id'],repr(c['full_name']),screen.person_key(c['full_name'],s.script_lexicon) if c['type']=='individual' else screen.entity_key(c['full_name']))\n  for n in names: print(' ->',repr(n),screen.person_key(n,s.script_lexicon) if c['type']=='individual' else screen.entity_key(n))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
