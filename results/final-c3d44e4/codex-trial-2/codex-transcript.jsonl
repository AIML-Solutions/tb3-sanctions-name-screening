{"type":"item.started","item":{"id":"item_84","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport csv,json,screen,difflib,collections\nW=json.load(open('watchlist.json'));S=screen.Screener(W);C=list(csv.DictReader(open('customers.csv')));P={x['customer_id']:x for x in csv.DictReader(open('/tmp/decisions_current4.csv'))}\n# unique target keys and entries\nitems=[]; seen=set(); idx=collections.defaultdict(set)\nfor e in W:\n if e['type']=='individual':\n  for k,wk in S.prepared[e['uid']]:\n   if not wk and len(k)==2 and (e['uid'],k) not in seen:\n    j=len(items);items.append((e,k));seen.add((e['uid'],k))\n    for t in k:idx[(t[0],len(t))].add(j)\ndef ids_for(t):\n r=set()\n for n in range(max(1,len(t)-3),len(t)+4):r |= idx.get((t[0],n),set())\n return r\ndef sr(a,b):return difflib.SequenceMatcher(None,a,b).ratio()\ndef score(a,b):return max((sr(a[0],b[0])+sr(a[1],b[1]))/2,(sr(a[0],b[1])+sr(a[1],b[0]))/2)\nout=[]\nfor c in C:\n if P[c['customer_id']]['decision']\"'!='\"'NO_MATCH' or c['type']\"'!='\"'individual':continue\n ck=S.prepared.get('none') or screen.person_key(c['full_name'],S.script_lexicon)\n if len(ck)\"'!=2:continue\n cand=ids_for(ck[0]) & ids_for(ck[1])\n best=None\n for j in cand:\n  e,k=items[j]\n  if not screen.dob_compatible(c['\"'dob'],e['dob']):continue\n  q=score(ck,k)\n  if best is None or q>best[0]:best=(q,e,k)\n if best and best[0]>=.88:out.append((best[0],c['customer_id'],c['full_name'],c['dob'],ck,best[1]['uid'],best[1]['primary_name'],best[1]['dob'],best[2]))\nfor x in sorted(out,reverse=True):print(x)\nprint('count',len(out))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
