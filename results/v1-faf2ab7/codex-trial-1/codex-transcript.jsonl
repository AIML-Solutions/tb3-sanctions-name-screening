{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport csv,json,re\nfrom unidecode import unidecode\nfrom rapidfuzz import fuzz,process\nW=json.load(open('watchlist.json'))\nC={x['customer_id']:x for x in csv.DictReader(open('dev/customers_dev.csv'))}\nL=list(csv.DictReader(open('dev/labels_dev.csv')))\ndef n(s): return re.sub('[\"'^a-z0-9]'\"','',unidecode(s).lower())\nchoices=[]\nfor e in W:\n for nm in [e['primary_name'],e.get('script_name') or '']+[a['name'] for a in e['aliases'] if a['strength']=='strong']:\n  if nm: choices.append((n(nm),e,nm))\nfor cls in ['D2_near_name','D1_name_dob_conflict','D5_partial_dob_conflict']:\n print('\\\\n##',cls)\n for l in [z for z in L if z['class']==cls]:\n  c=C[l['customer_id']]; q=n(c['full_name'])\n  best=sorted(((fuzz.ratio(q,x[0]),x) for x in choices),reverse=True,key=lambda z:z[0])[:2]\n  print(c['customer_id'],repr(c['full_name']),c['dob'],'=>',[(round(sc),x[1]['uid'],x[2],x[1]['dob']) for sc,x in best])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
