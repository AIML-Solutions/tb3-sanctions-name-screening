{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport json,re,unicodedata,collections\nw=json.load(open('watchlist.json'))\ndef script(s):\n cs=collections.Counter()\n for c in s:\n  n=unicodedata.name(c,'')\n  if 'ARABIC' in n: cs['arabic']+=1\n  if 'CYRILLIC' in n: cs['cyrillic']+=1\n return cs.most_common(1)[0][0] if cs else 'latin'\ndef toks(s):return re.findall(r\\\"[\"'^'\"\\\\W_]+\\\",s.lower(),re.UNICODE)\nfor sc in ['arabic','cyrillic']:\n m=collections.defaultdict(collections.Counter)\n for x in w:\n  a=x.get('script_name') or '' ; p=x['primary_name']\n  if script(a)\"'!=sc or script(p)!='\"'latin':continue\n  aa=toks(a); pp=toks(p)\n  if len(aa)==len(pp):\n   for z,y in zip(aa,pp):m[z][y]+=1\n print('\\\\n###',sc,'tokens',len(m))\n for k,v in sorted(m.items()):print(k,':',','.join(f'{a}({b})' for a,b in v.most_common()))\nprint('\\\\nLatin primary tokens by script background')\nfor sc in ['arabic','cyrillic']:\n cc=collections.Counter()\n for x in w:\n  if script(x.get('script_name') or '')==sc and script(x['primary_name'])=='latin': cc.update(toks(x['primary_name']))\n print(sc,len(cc));print(' '.join(k for k,v in cc.most_common()))\nprint('\\\\nNo-script individual tokens')\ncc=collections.Counter()\nfor x in w:\n if x['type']=='individual' and not x.get('script_name'):cc.update(toks(x['primary_name']))\nprint(len(cc));print(' '.join(k for k,v in cc.most_common()))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
