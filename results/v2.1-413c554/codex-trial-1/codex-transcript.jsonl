{"type":"item.started","item":{"id":"item_56","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport csv,json,difflib,screen\nw=json.load(open('watchlist.json'));eng=screen.Screener(w);cs=list(csv.DictReader(open('customers.csv')));ps={x['customer_id']:x for x in csv.DictReader(open('decisions.csv'))};best={}\nfor c in cs:\n if c['type']\"'!='\"'individual' or ps[c['customer_id']]['decision']=='MATCH' or len(c['dob'])\"'!=10:continue\n for e,cu,sigs in eng.prepared:\n  if e['\"'type']\"'!='\"'individual' or e['dob']\"'!=c['\"'dob']:continue\n  a=''.join(screen.individual_signature(c['full_name'],cu,eng.script_map))\n  for es,st,n in sigs:\n   if st\"'!='\"'strong':continue\n   r=difflib.SequenceMatcher(None,a,''.join(es)).ratio();z=(r,e['uid'],e['primary_name'],a,''.join(es))\n   if c['customer_id'] not in best or z>best[c['customer_id']]:best[c['customer_id']]=z\nxs=sorted(((z[0],cid,next(c for c in cs if c['customer_id']==cid)['full_name'],next(c for c in cs if c['customer_id']==cid)['dob'],*z[1:]) for cid,z in best.items()),reverse=True)\nprint('candidates',len(xs),'rat>=',[(t,sum(x[0]>=t for x in xs)) for t in [.9,.8,.7,.6,.5]])\nfor x in xs[:180]:print(f'{x[0]:.3f}\\\\t{x[1]}\\\\t{x[2]}\\\\t{x[3]}\\\\t{x[4]}\\\\t{x[5]}\\\\t{x[6]}|{x[7]}')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
