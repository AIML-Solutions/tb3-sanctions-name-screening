{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport json,re,unicodedata,collections\nw=json.load(open('watchlist.json'))\ndef sc(s):\n for c in s:\n  n=unicodedata.name(c,'')\n  if 'ARABIC' in n:return 'ar'\n  if 'CYRILLIC' in n:return 'cy'\n return 'la'\ndef tok(s):return re.findall(r'[\"'^'\"\\\\W_]+',s.lower())\nfor typ in ['ar','cy']:\n all=set(); paired=set();\n for x in w:\n  ss=x.get('script_name') or ''\n  if sc(ss)==typ:\n   all.update(tok(ss))\n   if sc(x['primary_name'])=='la' and len(tok(ss))==len(tok(x['primary_name'])):paired.update(tok(ss))\n print(typ,'all',len(all),'unmapped',len(all-paired),sorted(all-paired))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
