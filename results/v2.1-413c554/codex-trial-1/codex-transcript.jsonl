{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport csv,json,re,unicodedata,collections\nw=json.load(open('watchlist.json')); wd={x['uid']:x for x in w}\ncs={x['customer_id']:x for x in csv.DictReader(open('dev/customers_dev.csv'))}; labs=list(csv.DictReader(open('dev/labels_dev.csv')))\ndef strip(s):return ''.join(c for c in unicodedata.normalize('NFKD',s.lower()) if not unicodedata.combining(c))\ndef tok(s):return re.findall(r\\\"[\"'^'\"\\\\W_]+\\\",strip(s))\ndef lat(s):return all(not ('ARABIC' in unicodedata.name(c,'') or 'CYRILLIC' in unicodedata.name(c,'')) for c in s)\npairs=collections.Counter()\n# primary strong alias equal positions, latin only\nfor e in w:\n p=tok(e['primary_name'])\n for a in e['aliases']:\n  q=tok(a['name'])\n  if a['strength']=='strong' and lat(e['primary_name']) and len(p)==len(q):\n   for x,y in zip(p,q):\n    if x\"'!=y:pairs[tuple(sorted((x,y)))]+=1\nprint('\"'WATCH STRONG TOKEN PAIRS')\nfor p,n in pairs.most_common():print(*p,n)\n# customer expected compare to each latin name same # toks; choose with fewest unequal positions then output\npairs=collections.Counter()\nexamples=[]\nfor l in labs:\n if l['expected_decision']\"'!='\"'MATCH':continue\n c=tok(cs[l['customer_id']]['full_name']); e=wd[l['expected_uid']]\n opts=[e['primary_name']]+[a['name'] for a in e['aliases'] if a['strength']=='strong']\n opts=[tok(a) for a in opts if lat(a) and len(tok(a))==len(c)]\n if not opts:continue\n q=min(opts,key=lambda q:sum(x\"'!=y for x,y in zip(c,q)))\n for x,y in zip(c,q):\n  if x!=y:pairs[tuple(sorted((x,y)))]+=1\nprint('\"'\\\\nDEV SAMEPOS TOKEN PAIRS')\nfor p,n in pairs.most_common():print(*p,n)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
