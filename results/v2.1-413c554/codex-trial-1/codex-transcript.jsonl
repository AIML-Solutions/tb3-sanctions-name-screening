{"type":"item.started","item":{"id":"item_95","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport csv,json,difflib,collections,screen\nw=json.load(open('watchlist.json'));eng=screen.Screener(w);cs=list(csv.DictReader(open('customers.csv')));ps={x['customer_id']:x for x in csv.DictReader(open('decisions.csv'))}\n# entry items and trigram/bigram index by culture\nitems=[];idx=collections.defaultdict(set)\nfor e,cu,sigs in eng.prepared:\n if e['type']\"'!='\"'individual':continue\n for sig,st,n in sigs:\n  if st\"'!='\"'strong':continue\n  s=''.join(sig);i=len(items);items.append((e,cu,s,n))\n  for k in {s[j:j+2] for j in range(len(s)-1)}:idx[(cu,k)].add(i)\nbest=[]\nfor c in cs:\n if c['type']\"'!='\"'individual' or ps[c['customer_id']]['decision']=='MATCH':continue\n bz=None\n for cu in ['arabic','russian','chinese','western']:\n  sig=screen.individual_signature(c['full_name'],cu,eng.script_map);s=''.join(sig)\n  cand=collections.Counter()\n  for k in {s[j:j+2] for j in range(len(s)-1)}:\n   for i in idx.get((cu,k),()):cand[i]+=1\n  for i,nsh in cand.most_common(80):\n   e,_,t,n=items[i]\n   if not screen.dob_consistent(c['dob'],e['dob']):continue\n   r=difflib.SequenceMatcher(None,s,t).ratio()\n   z=(r,e['uid'],e['primary_name'],s,t,cu)\n   if bz is None or z>bz:bz=z\n if bz:best.append((bz[0],c['customer_id'],c['full_name'],c['dob'],*bz[1:]))\nbest.sort(reverse=True)\nprint('n',len(best),[(t,sum(x[0]>=t for x in best)) for t in [.98,.95,.9,.85,.8,.75]])\nfor x in best[:220]:print('\\\\t'.join(map(str,x)))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
