{"type":"item.started","item":{"id":"item_107","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\n# Reuse trigram nearest search; show only very high residuals.\nimport csv,json,difflib,collections,screen\nw=json.load(open('watchlist.json'));eng=screen.Screener(w);cs=list(csv.DictReader(open('customers.csv')));ps={x['customer_id']:x for x in csv.DictReader(open('decisions.csv'))};items=[];idx=collections.defaultdict(set)\nfor e,cu,sigs in eng.prepared:\n if e['type']=='individual':\n  for sig,st,n in sigs:\n   if st=='strong':\n    s=''.join(sig);i=len(items);items.append((e,cu,s));\n    for k in {s[j:j+2] for j in range(len(s)-1)}:idx[(cu,k)].add(i)\nout=[]\nfor c in cs:\n if c['type']\"'!='\"'individual' or ps[c['customer_id']]['decision']=='MATCH':continue\n bz=(0,'','','','','')\n for cu in ['arabic','russian','chinese','western']:\n  s=''.join(screen.individual_signature(c['full_name'],cu,eng.script_map));can=set()\n  for k in {s[j:j+2] for j in range(len(s)-1)}:can.update(idx.get((cu,k),()))\n  for i in can:\n   e,_,t=items[i]\n   if not screen.dob_consistent(c['dob'],e['dob']):continue\n   r=difflib.SequenceMatcher(None,s,t).ratio()\n   if r>bz[0]:bz=(r,e['uid'],e['primary_name'],s,t,cu)\n if bz[0]>=.90:out.append((bz[0],c['customer_id'],c['full_name'],c['dob'],*bz[1:]))\nout.sort(reverse=True);print('n',len(out))\nfor x in out:print('\\\\t'.join(map(str,x)))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
