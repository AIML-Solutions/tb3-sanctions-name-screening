{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport csv,json,re,unicodedata\nw=json.load(open('watchlist.json')); cs=list(csv.DictReader(open('dev/customers_dev.csv'))); ls=list(csv.DictReader(open('dev/labels_dev.csv')))\ndef norm(s):\n s=unicodedata.normalize('NFKD',s.lower())\n return ''.join(c for c in s if c.isalnum() and not unicodedata.combining(c))\ndef lev(a,b):\n row=list(range(len(b)+1))\n for i,x in enumerate(a,1):\n  nr=[i]\n  for j,y in enumerate(b,1):nr.append(min(nr[-1]+1,row[j]+1,row[j-1]+(x\"'!=y)))\n  row=nr\n return row[-1]\nfor lab in [x for x in ls if x['\"'class']=='D2_near_name'][:30]:\n c=next(z for z in cs if z['customer_id']==lab['customer_id']); a=norm(c['full_name'])\n cand=[]\n for e in w:\n  if e['type']\"'!=c['\"'type']:continue\n  for n in [e['primary_name'],e.get('script_name') or '']+[z['name'] for z in e['aliases'] if z['strength']=='strong']:\n   if not n:continue\n   b=norm(n); d=lev(a,b); cand.append((d/max(len(a),len(b)),d,e['uid'],n,e['dob']))\n cand.sort()\n print(c['full_name'],c['dob'],'=>',cand[:3])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
