,\"tikreti\",\n                \"douri\",\"zahrani\",\"rashid\",\"hashemi\",\"hashimi\",\"jabouri\",\"khatib\",\n                \"khateeb\",\"khateb\",\"masri\",\"farsi\",\"attar\",\"amin\",\"sabah\",\n            }:\n                return rest\n    return token\n\n\ndef _strip_attached_western_particle(token: str) -> str:\n    for prefix in (\"vander\", \"delac\", \"dela\", \"vande\", \"vonder\"):\n        if token.startswith(prefix) and len(token) - len(prefix) >= 3:\n            # delacruz -> cruz (the c belongs to Cruz), vanderberg -> berg\n            return (\"c\" if prefix == \"delac\" else \"\") + token[len(prefix):]\n    return token\n\n\ndef individual_tokens(name: str) -> list[str]:\n    words = latinize(name).split()\n    # Phrase compounds found in Arabic names.\n    merged: list[str] = []\n    i = 0\n    while i < len(words):\n        if i + 1 < len(words) and words[i:i+2] == [\"abd\", \"allah\"]:\n            merged.append(\"abdullah\"); i += 2; continue\n        if i + 1 < len(words) and words[i:i+2] == [\"nasr\", \"allah\"]:\n            merged.append(\"nasrallah\"); i += 2; continue\n        merged.append(words[i]); i += 1\n    words = merged\n\n    # Common joined forms of multiword name components.\n    compound = {\n        \"abdulaziz\":\"abdaziz\", \"abdulazez\":\"abdaziz\", \"abdelaziz\":\"abdaziz\",\n        \"abdelazez\":\"abdaziz\", \"abdoulaziz\":\"abdaziz\",\n    }\n    words = [compound.get(w, _strip_attached_western_particle(w)) for w in words]\n\n    # Articles may be standalone or attached.  A nasab marker and the father's\n    # following name are optional as a unit under the policy.\n    cleaned: list[str] = []\n    i = 0\n    while i < len(words):\n        w = words[i]\n        if w in {\"al\", \"el\"}:\n            i += 1; continue\n        if w in ARTICLES and i + 1 < len(words) and canon_token(words[i+1]) in ARABIC_FAMILIES:\n            i += 1; continue\n        if w in WESTERN_PARTICLES:\n            i += 1; continue\n        if w in NASAB and i > 0:\n            # Abdul/Abdel + a following component is one compound father's\n            # name, so the optional nasab unit consumes both words.\n            if i + 2 < len(words) and words[i+1] in {\"abd\", \"abdul\", \"abdel\", \"abdol\", \"abdoul\"}:\n                i += 3\n            else:\n                i += 2\n            continue\n        w = _strip_attached_article(w)\n        if len(w) == 1 and i > 0:  # a first-name initial is not a middle initial\n            i += 1; continue\n        # Russian patronymics are optional.\n        if re.search(r\"(?:ovich|evich|ich|ovna|evna|ichna)$\", w):\n            i += 1; continue\n        cw = canon_token(w)\n        if cw.endswith(\"a\") and canon_token(cw[:-1]) in RUSSIAN_SURNAMES:\n            cw = canon_token(cw[:-1])\n        cleaned.append(cw)\n        i += 1\n    return cleaned\n\n\ndef individual_forms(name: str) -> set[str]:\n    toks = individual_tokens(name)\n    if not toks:\n        return set()\n    variants = [toks]\n    # Russian feminine surnames correspond to the masculine form.  Restrict\n    # this to the known surname vocabulary so ordinary final-a names survive.\n    for pos, tok in enumerate(toks):\n        if tok.endswith(\"a\") and tok[:-1] in RUSSIAN_SURNAMES:\n            alt = toks.copy(); alt[pos] = tok[:-1]; variants.append(alt)\n    forms: set[str] = set()\n    for row in variants:\n        # Family-first versus family-last is a cyclic move.  Compacting also\n        # handles hyphen/space boundaries and joined Chinese given names.\n        for k in range(len(row)):\n            forms.add(\"\".join(row[k:] + row[:k]))\n        forms.add(\"\".join(reversed(row)))\n    return forms\n\n\nLEGAL = {\n    \"llc\",\"ltd\",\"limited\",\"liability\",\"company\",\"co\",\"sa\",\"gmbh\",\"jsc\",\"ao\",\n    \"oao\",\"pjsc\",\"corp\",\"corporation\",\"inc\",\"incorporated\",\"fze\",\"fz\",\"plc\",\n    \"ag\",\"bv\",\"nv\",\"sarl\",\"spa\",\"pte\",\"establishment\",\"free\",\"zone\",\"joint\",\n    \"stock\",\"public\",\"sociedad\",\"anonima\",\n}\n\n\ndef entity_form(name: str) -> str:\n    toks = latinize(name).split()\n    if toks and toks[0] == \"the\": toks = toks[1:]\n    toks = [t for t in toks if t not in {\"and\"}]\n    # Designators are non-distinctive.  The synthetic list uses these only as\n","exit_code":0,"status":"completed"}}
