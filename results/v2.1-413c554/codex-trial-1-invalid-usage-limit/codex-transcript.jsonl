{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport csv, json, collections\nwith open('dev/customers_dev.csv',encoding='utf-8-sig') as f: cs=list(csv.DictReader(f))\nwith open('dev/labels_dev.csv',encoding='utf-8-sig') as f: ls=list(csv.DictReader(f))\nwith open('watchlist.json',encoding='utf-8') as f: wl=json.load(f)\nbyid={x['customer_id']:x for x in cs}; byuid={x['uid']:x for x in wl}\nctr=collections.Counter((x['class'],x['expected_decision']) for x in ls)\nfor k,v in sorted(ctr.items()): print(f'{k[0]:28} {k[1]:8} {v}')\nprint('\\\\nWATCHLIST',len(wl),collections.Counter(x['type'] for x in wl))\nprint('script-only',sum(not any('a'<=c.lower()<='z' for c in x['primary_name']) for x in wl))\nprint('\\\\nEXAMPLES')\nfor cls in sorted({x['class'] for x in ls}):\n    print('\\\\n###',cls)\n    for l in [z for z in ls if z['class']==cls][:10]:\n        c=byid[l['customer_id']]; w=byuid.get(l['expected_uid'])\n        print(c['customer_id'],repr(c['full_name']),c['dob'],c['id_type'],c['id_number'],'=>',l['expected_decision'], l['expected_uid'], '::',repr(w['primary_name']) if w else '', 'aliases='+repr(w['aliases']) if w else '')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
