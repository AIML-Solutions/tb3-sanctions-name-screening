{"type":"item.started","item":{"id":"item_43","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport csv,json,difflib\nfrom screen import Matcher,individual_forms,dob_consistent\nw=json.load(open('watchlist.json'));m=Matcher(w); p={x['customer_id']:x for x in csv.DictReader(open('/tmp/batch_pass2.csv'))}; cs=list(csv.DictReader(open('customers.csv')));inds=[e for e in w if e['type']=='individual']\nef={e['uid']:set().union(*(individual_forms(n) for n in [e['primary_name'],e.get('script_name') or '']+[a['name'] for a in e['aliases'] if a['strength']=='strong'])) for e in inds}\ndef sc(a,b):return max((difflib.SequenceMatcher(None,x,y).ratio() for x in a for y in b),default=0)\nrows=[]\nfor c in cs:\n if c['type']\"'!='\"'individual' or p[c['customer_id']]['decision']=='MATCH' or len(c['dob'])\"'!=10:continue\n cand=[e for e in inds if e['\"'dob']==c['dob']]\n if not cand:continue\n cf=individual_forms(c['full_name']); ss=sorted([(sc(cf,ef[e['uid']]),e) for e in cand],reverse=True,key=lambda z:z[0]);rows.append((ss[0][0],c,ss[0][1],len(cand)))\nprint('ROWS',len(rows))\nfor s,c,e,n in sorted(rows,key=lambda z:-z[0]):print(f'{s:.3f}\\\\t{c[\\\"customer_id\\\"]}\\\\t{c[\\\"full_name\\\"]}\\\\t{c[\\\"dob\\\"]}\\\\t{e[\\\"uid\\\"]}\\\\t{e[\\\"primary_name\\\"]}\\\\t{n}')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
