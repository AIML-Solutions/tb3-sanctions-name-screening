{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nmods=['unidecode','text_unidecode','rapidfuzz','Levenshtein','jellyfish','pypinyin','transliterate','icu','pyarabic']\nfor m in mods:\n try:\n  x=__import__(m); print(m,'YES',getattr(x,'__version__',''))\n except Exception as e: print(m,'NO')\nPY\npython - <<'PY'\nimport json,collections,re\nw=json.load(open('watchlist.json'))\nfor typ in ['individual','entity','vessel']:\n xs=[x for x in w if x['type']==typ]\n print(typ,len(xs),'dob',sum(bool(x['dob']) for x in xs),'ids',sum(bool(x['ids']) for x in xs),'aliases',sum(bool(x['aliases']) for x in xs))\nprint('alias strengths',collections.Counter(a['strength'] for x in w for a in x['aliases']))\nprint('name script categories')\nfor tag,pat in [('arabic',r'[\\\\u0600-\\\\u06ff]'),('cyrillic',r'[\\\\u0400-\\\\u04ff]'),('latin',r'[A-Za-z]'),('han',r'[\\\\u4e00-\\\\u9fff]')]: print(tag,sum(bool(re.search(pat,x['primary_name'])) for x in w))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
