{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport json,csv,re,unicodedata,collections\nw=json.load(open('watchlist.json'))\ncs=list(csv.DictReader(open('dev/customers_dev.csv'))); lab={x['customer_id']:x for x in csv.DictReader(open('dev/labels_dev.csv'))}; wu={x['uid']:x for x in w}\ndef n(s):\n s=''.join(c for c in unicodedata.normalize('NFKD',s.lower()) if not unicodedata.combining(c))\n return ' '.join(re.findall(r'[a-z0-9]+',s))\nfor cls in ['T1_translit','T2_script','T3_structure','T10_stacked','T11_twin','D2_near_name','D6_same_given']:\n print('\\\\n',cls)\n arr=[c for c in cs if lab[c['customer_id']]['class']==cls]\n for c in arr[:50]:\n  l=lab[c['customer_id']]\n  if l['expected_uid']:\n   x=wu[l['expected_uid']]; names=[x['primary_name']]+[a['name'] for a in x['aliases'] if a['strength']=='strong']\n   scores=[(sum(1 for a,b in zip(n(c['full_name']),n(y)) if a==b),n(y),y) for y in names]\n   print(repr(c['full_name']),'::',repr(x['primary_name']),' STR=',[a['name'] for a in x['aliases'] if a['strength']=='strong'])\n  else:\n   # nearest based token edit using difflib among latin\n   from difflib import SequenceMatcher\n   cand=[]\n   for x in w:\n    if x['type']\"'!=c['\"'type']: continue\n    for y in [x['primary_name']]+[a['name'] for a in x['aliases'] if a['strength']=='strong']:\n     q=SequenceMatcher(None,n(c['full_name']),n(y)).ratio()\n     if q>.7:cand.append((q,x['uid'],y,x['dob']))\n   print(repr(c['full_name']),c['dob'],'NEAR',sorted(cand,reverse=True)[:2])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
