{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport csv,json,difflib,re,collections\nfrom screen import Matcher, individual_forms, dob_consistent\nw=json.load(open('watchlist.json')); m=Matcher(w)\np={x['customer_id']:x for x in csv.DictReader(open('/tmp/batch_pass1.csv'))}; cs=list(csv.DictReader(open('customers.csv')))\ninds=[e for e in w if e['type']=='individual']\ndef forms_e(e):\n ns=[e['primary_name']]+([e['script_name']] if e.get('script_name') else [])+[a['name'] for a in e['aliases'] if a['strength']=='strong']\n return set().union(*(individual_forms(x) for x in ns))\nef={e['uid']:forms_e(e) for e in inds}\ndef score(a,b): return max((difflib.SequenceMatcher(None,x,y).ratio() for x in a for y in b),default=0)\nrows=[]\nfor c in cs:\n if c['type']\"'!='\"'individual' or p[c['customer_id']]['decision']=='MATCH' or not c['dob']:continue\n cf=individual_forms(c['full_name'])\n cand=[e for e in inds if dob_consistent(c['dob'],e['dob']) and e['dob']]\n ss=sorted(((score(cf,ef[e['uid']]),e) for e in cand),key=lambda x:(-x[0],x[1]['uid']))[:2]\n if ss: rows.append((ss[0][0],c,ss))\nprint('unmatched dated',len(rows),'by precision',collections.Counter(len(x[1]['dob']) for x in rows))\nfor s,c,ss in sorted(rows,key=lambda x:-x[0])[:500]:\n if s<.42:break\n print(f'{s:.3f}',c['customer_id'],repr(c['full_name']),c['dob'],'=>',[(round(z,3),e['uid'],e['primary_name'],e['dob']) for z,e in ss])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
