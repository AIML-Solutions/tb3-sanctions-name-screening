{"type":"item.started","item":{"id":"item_81","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport sys,csv,json,difflib,collections\nsys.path.insert(0,'/app');import screen\nw=json.load(open('/app/watchlist.json')); eng=screen.Engine(w); ps={x['customer_id']:x for x in csv.DictReader(open('/tmp/main_pred_enh4.csv'))}\n# signatures by entry, excluding prefix marker\nes=collections.defaultdict(set); inv=collections.defaultdict(set)\nfor sig,ids in eng.name_index.items():\n if not sig.startswith(('A:','R:','C:','W:')):continue\n for i in ids:es[i].add(sig)\nfor i,sigs in es.items():\n for s in sigs:\n  for j in range(len(s)-2):inv[s[j:j+3]].add(i)\nrows=[]\nfor c in csv.DictReader(open('/app/customers.csv')):\n if c['type']\"'!='\"'individual' or ps[c['customer_id']]['decision']\"'!='\"'NO_MATCH':continue\n cs=set()\n for culture in eng.cultures:cs |= screen.individual_signatures(c['full_name'],culture)\n cand=collections.Counter()\n for s in cs:\n  for j in range(len(s)-2):\n   for i in inv.get(s[j:j+3],()):cand[i]+=1\n best=(0,None,None)\n for i,_ in cand.most_common(100):\n  if not screen.dob_compatible(c['dob'],w[i]['dob']):continue\n  score=max(difflib.SequenceMatcher(None,a,b).ratio() for a in cs for b in es[i] if a[:2]==b[:2])\n  if score>best[0]:best=(score,i,max(((difflib.SequenceMatcher(None,a,b).ratio(),a,b) for a in cs for b in es[i] if a[:2]==b[:2]),default=(0,'','')))\n if best[0]>=.69:\n  i=best[1];rows.append((best[0],c['customer_id'],c['full_name'],c['dob'],w[i]['uid'],w[i]['primary_name'],w[i]['dob'],best[2][1],best[2][2]))\nfor x in sorted(rows,reverse=True)[:350]:print(x)\nprint('rows',len(rows))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
