{"type":"item.started","item":{"id":"item_44","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport sys,csv,json,collections,difflib\nsys.path.insert(0,'/app'); import screen\nw=json.load(open('/app/watchlist.json')); ps={x['customer_id']:x for x in csv.DictReader(open('/tmp/main_pred_current.csv'))}\nwt=collections.Counter()\nfor e in w:\n if e['type']=='individual':\n  for n in [e['primary_name'],e.get('script_name') or '']+[a['name'] for a in e['aliases'] if a['strength']=='strong']:\n   wt.update(screen._base_individual_words(n))\nct=collections.Counter()\nfor c in csv.DictReader(open('/app/customers.csv')):\n if c['type']=='individual' and ps[c['customer_id']]['decision']=='NO_MATCH': ct.update(screen._base_individual_words(c['full_name']))\nknown=set(wt); rows=[]\nfor tok,n in ct.items():\n if tok in known or tok in {'bin','ibn','ben','al','el','and'}: continue\n near=difflib.get_close_matches(tok,known,n=4,cutoff=.55)\n rows.append((n,tok,[(x,round(difflib.SequenceMatcher(None,tok,x).ratio(),2),wt[x]) for x in near]))\nfor row in sorted(rows,reverse=True)[:220]:print(row)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
