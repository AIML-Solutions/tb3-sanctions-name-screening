{"type":"item.started","item":{"id":"item_92","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport sys,csv,json,difflib,collections\nsys.path.insert(0,'/app');import screen\nw=json.load(open('/app/watchlist.json')); eng=screen.Engine(w); ps={x['customer_id']:x for x in csv.DictReader(open('/tmp/main_pred_enh5.csv'))}\nes=collections.defaultdict(set);inv=collections.defaultdict(set)\nfor sig,ids in eng.name_index.items():\n if sig[:2] in {'A:','R:','C:','W:'}:\n  for i in ids:es[i].add(sig)\nfor i,sigs in es.items():\n for s in sigs:\n  for j in range(len(s)-2):inv[s[j:j+3]].add(i)\nrows=[]\nfor c in csv.DictReader(open('/app/customers.csv')):\n if c['type']\"'!='\"'individual' or c['dob'] or ps[c['customer_id']]['decision']\"'!='\"'NO_MATCH':continue\n cs=set()\n for culture in eng.cultures:cs|=screen.individual_signatures(c['full_name'],culture)\n cand=collections.Counter()\n for s in cs:\n  for j in range(len(s)-2):\n   for i in inv.get(s[j:j+3],()):cand[i]+=1\n best=(0,None)\n for i,_ in cand.most_common(80):\n  score=max((difflib.SequenceMatcher(None,a,b).ratio() for a in cs for b in es[i] if a[:2]==b[:2]),default=0)\n  if score>best[0]:best=(score,i)\n if best[0]>=.88:\n  x=w[best[1]];rows.append((best[0],c['customer_id'],c['full_name'],x['uid'],x['primary_name'],x['dob']))\nfor x in sorted(rows,reverse=True):print(x)\nprint('rows',len(rows))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
