{"type":"item.started","item":{"id":"item_105","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport sys,csv,json,difflib\nsys.path.insert(0,'/app');import screen\nw=json.load(open('/app/watchlist.json'));eng=screen.Engine(w);ps={x['customer_id']:x for x in csv.DictReader(open('/tmp/main_pred_enh6.csv'))}\ndef f(n):\n t=[screen.canonical_word(x) for x in screen.raw_tokens(n) if len(x)>1 and x not in screen.AR_ARTICLES|screen.NASAB];t=[x for x in t if not screen.PATRONYMIC_RE.search(x)];return [''.join(t),''.join(reversed(t)),''.join(sorted(t))]\ndef sim(a,n):return max(difflib.SequenceMatcher(None,x,y).ratio() for x in a for y in f(n))\nrows=[]\nfor c in csv.DictReader(open('/app/customers.csv')):\n if c['type']\"'!='\"'individual' or ps[c['customer_id']]['decision']\"'!='\"'NO_MATCH' or not c['dob']:continue\n a=f(c['full_name']);cand=[]\n for x in w:\n  if x['type']=='individual' and x['dob'] and x['dob'].startswith(c['dob']):\n   z=max((sim(a,n),n) for n in [x['primary_name']]+[q['name'] for q in x['aliases'] if q['strength']=='strong']);cand.append((z[0],x['uid'],z[1],x['dob']))\n if cand and .55<=max(cand)[0]<.75:rows.append((max(cand)[0],c['customer_id'],c['full_name'],c['dob'])+max(cand)[1:])\nfor x in sorted(rows,reverse=True):print(x)\nprint('rows',len(rows))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
