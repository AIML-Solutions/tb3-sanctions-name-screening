{"type":"item.started","item":{"id":"item_45","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport sys,csv,json,difflib,re\nsys.path.insert(0,'/app');import screen\nw=json.load(open('/app/watchlist.json')); ps={x['customer_id']:x for x in csv.DictReader(open('/tmp/main_pred_current.csv'))}\ndef forms(n):\n t=[screen.canonical_word(x) for x in screen.raw_tokens(n) if len(x)>1 and x not in {'al','el','bin','ben','ibn'}]\n # extra removal of patronymics\n t=[x for x in t if not screen.PATRONYMIC_RE.search(x)]\n return [''.join(t),''.join(reversed(t)),''.join(sorted(t))]\ndef sim(a,b):return max(difflib.SequenceMatcher(None,x,y).ratio() for x in forms(a) for y in forms(b))\nrows=[]\nfor c in csv.DictReader(open('/app/customers.csv')):\n if c['type']\"'!='\"'individual' or ps[c['customer_id']]['decision']\"'!='\"'NO_MATCH' or not c['dob']:continue\n cand=[]\n for x in w:\n  if x['type']\"'!='\"'individual' or not screen.dob_compatible(c['dob'],x['dob']):continue\n  names=[x['primary_name']]+[a['name'] for a in x['aliases'] if a['strength']=='strong']\n  z=max((sim(c['full_name'],n),n) for n in names)\n  cand.append((z[0],x['uid'],z[1],x['dob']))\n if cand:\n  best=max(cand)\n  if best[0]>=.46:rows.append((best[0],c['customer_id'],c['full_name'],c['dob'],best[1],best[2],best[3]))\nfor x in sorted(rows,reverse=True):print(x)\nprint('rows',len(rows))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
