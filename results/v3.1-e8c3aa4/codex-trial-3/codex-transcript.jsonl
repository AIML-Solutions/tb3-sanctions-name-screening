{"type":"item.started","item":{"id":"item_91","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport sys,csv,json,difflib\nsys.path.insert(0,'/app');import screen\nw=json.load(open('/app/watchlist.json')); ps={x['customer_id']:x for x in csv.DictReader(open('/tmp/main_pred_enh5.csv'))}\ndef forms(n):\n t=[screen.canonical_word(x) for x in screen.raw_tokens(n) if len(x)>1 and x not in screen.AR_ARTICLES|screen.NASAB]\n t=[x for x in t if not screen.PATRONYMIC_RE.search(x)]\n return [''.join(t),''.join(reversed(t)),''.join(sorted(t))]\ndef sim(af,b):return max(difflib.SequenceMatcher(None,x,y).ratio() for x in af for y in forms(b))\nrows=[]\nfor c in csv.DictReader(open('/app/customers.csv')):\n if c['type']\"'!='\"'individual' or ps[c['customer_id']]['decision']\"'!='\"'NO_MATCH' or not c['dob']:continue\n af=forms(c['full_name']);cand=[]\n for x in w:\n  if x['type']\"'!='\"'individual' or not x['dob'] or not x['dob'].startswith(c['dob']):continue\n  names=[x['primary_name']]+[a['name'] for a in x['aliases'] if a['strength']=='strong'];z=max((sim(af,n),n) for n in names);cand.append((z[0],x['uid'],z[1],x['dob']))\n if cand and max(cand)[0]>=.74:rows.append((max(cand)[0],c['customer_id'],c['full_name'],c['dob'])+max(cand)[1:])\nfor x in sorted(rows,reverse=True):print(x)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
