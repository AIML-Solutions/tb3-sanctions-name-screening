{"type":"item.started","item":{"id":"item_59","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport csv,json,difflib,unicodedata\nW=json.load(open('/app/watchlist.json'));C=list(csv.DictReader(open('/app/customers.csv')));P={x['customer_id']:x for x in csv.DictReader(open('/app/decisions.csv'))}\ndef f(s):\n s=''.join(x for x in unicodedata.normalize('NFKD',s.casefold()) if not unicodedata.combining(x))\n return ''.join(x for x in s if x.isalpha())\nN=[]\nfor e in W:\n if e['type']=='individual':\n  for n in [e['primary_name']]+[a['name'] for a in e['aliases'] if a['strength']=='strong']:\n   if all(ord(x)<128 for x in n):N.append((f(n),n,e))\nz=[]\nfor c in C:\n if c['type']=='individual' and not c['dob'] and P[c['customer_id']]['decision']=='NO_MATCH':\n  fc=f(c['full_name']); best=(0,None,None)\n  for k,n,e in N:\n   # cheap length/lower-bound filter\n   if min(len(fc),len(k))/max(len(fc),len(k)) < .7:continue\n   v=difflib.SequenceMatcher(None,fc,k).ratio()\n   if v>best[0]:best=(v,n,e)\n  if best[0]>=.78:z.append((best[0],c,best))\nprint(len(z))\nfor x,c,q in sorted(z,reverse=True,key=lambda x:x[0]):print(c['customer_id'],repr(c['full_name']),'~',round(x,2),repr(q[1]),q[2]['uid'],repr(q[2]['primary_name']),q[2]['dob'])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
