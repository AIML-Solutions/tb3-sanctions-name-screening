{"type":"item.started","item":{"id":"item_54","type":"command_execution","command":"/bin/bash -lc \"python3 -m py_compile /app/screen.py\npython3 /app/screen.py --watchlist /app/watchlist.json --customers /app/dev/customers_dev.csv --out /tmp/decisions_dev.csv\npython3 /app/screen.py --watchlist /app/watchlist.json --customers /app/customers.csv --out /app/decisions.csv\npython3 - <<'PY'\nimport csv,collections\nL=list(csv.DictReader(open('/app/dev/labels_dev.csv')));P={x['customer_id']:x for x in csv.DictReader(open('/tmp/decisions_dev.csv'))};C={x['customer_id']:x for x in csv.DictReader(open('/app/dev/customers_dev.csv'))};E=[]\nfor x in L:\n p=P[x['customer_id']]\n if (p['decision'],p['matched_uid'])\"'!=(x['\"'expected_decision'],x['expected_uid']):E.append((x,C[x['customer_id']],p))\nprint('dev exact',len(L)-len(E),'/',len(L))\nfor x,c,p in E:print(x['class'],x['customer_id'],repr(c['full_name']),'exp',x['expected_decision'],x['expected_uid'],'got',p['decision'],p['matched_uid'])\nP={x['customer_id']:x for x in csv.DictReader(open('/app/decisions.csv'))};print('main',collections.Counter(x['decision'] for x in P.values()))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
