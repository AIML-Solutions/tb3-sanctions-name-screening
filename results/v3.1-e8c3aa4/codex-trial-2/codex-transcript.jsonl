{"type":"item.started","item":{"id":"item_75","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport csv,json,collections,difflib,importlib.util\ns=importlib.util.spec_from_file_location('s','/app/screen.py');m=importlib.util.module_from_spec(s);s.loader.exec_module(m)\nW=json.load(open('/app/watchlist.json'));C=list(csv.DictReader(open('/app/customers.csv')));P={x['customer_id']:x for x in csv.DictReader(open('/app/decisions.csv'))};d=collections.defaultdict(list)\nfor e in W:\n if e['type']=='individual' and len(e['dob'])==10:d[e['dob']].append(e)\ndef score(a,b):\n A=m.individual_signatures(a);B=m.individual_signatures(b);best=0\n for x in A:\n  for y in B:\n   s1=(difflib.SequenceMatcher(None,x[0],y[0]).ratio()+difflib.SequenceMatcher(None,x[1],y[1]).ratio())/2\n   s2=(difflib.SequenceMatcher(None,x[0],y[1]).ratio()+difflib.SequenceMatcher(None,x[1],y[0]).ratio())/2\n   best=max(best,s1,s2)\n return best\nz=[]\nfor c in C:\n if c['type']=='individual' and len(c['dob'])==10 and P[c['customer_id']]['decision']=='NO_MATCH' and d[c['dob']]:\n  best=[]\n  for e in d[c['dob']]:\n   ns=[e['primary_name']]+[a['name'] for a in e['aliases'] if a['strength']=='strong']\n   q=max((score(c['full_name'],n),n) for n in ns)\n   best.append((q,e))\n  q=max(best,key=lambda x:x[0][0]);z.append((q[0][0],c,q))\nfor sc,c,q in sorted(z,reverse=True,key=lambda x:x[0]):\n e=q[1];print(f'{sc:.2f}',c['customer_id'],repr(c['full_name']),'~',e['uid'],repr(e['primary_name']),'via',repr(q[0][1]),'TOK',m.individual_tokens(c['full_name']),'/',m.individual_tokens(q[0][1]))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
