{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport csv,json,collections\nW=json.load(open('/app/watchlist.json',encoding='utf-8'))\nC={r['customer_id']:r for r in csv.DictReader(open('/app/dev/customers_dev.csv',encoding='utf-8'))}\nL=list(csv.DictReader(open('/app/dev/labels_dev.csv',encoding='utf-8')))\nprint('watch entries',len(W),collections.Counter(x['type'] for x in W))\nprint('script primary',sum(x['primary_name']==x.get('script_name') and x.get('script_name') for x in W),'script any',sum(bool(x.get('script_name')) for x in W))\nprint('aliases',sum(len(x['aliases']) for x in W),collections.Counter(a['strength'] for x in W for a in x['aliases']))\nprint('dob',collections.Counter(len(x['dob']) for x in W))\nprint('ids',collections.Counter(i['type'] for x in W for i in x['ids']))\nprint('dev actual types',collections.Counter(C[x['customer_id']]['type'] for x in L))\nprint()\nfor cls in sorted(set(x['class'] for x in L)):\n print('\\\\n###',cls)\n for lab in [x for x in L if x['class']==cls][:12]:\n  c=C[lab['customer_id']]\n  target=next((x for x in W if x['uid']==lab['expected_uid']),None)\n  print({k:c[k] for k in ('customer_id','full_name','dob','id_type','id_number','type')},'=>',lab['expected_decision'],lab['expected_uid'], 'TARGET='+repr((target or {}).get('primary_name')), 'DOB='+repr((target or {}).get('dob')))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
