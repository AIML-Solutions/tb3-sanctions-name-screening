{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport importlib.util,json,csv\ns=importlib.util.spec_from_file_location('s','/app/screen.py'); m=importlib.util.module_from_spec(s); s.loader.exec_module(m)\nW={x['uid']:x for x in json.load(open('/app/watchlist.json',encoding='utf8'))}\nchecks=[\n('D176007','SDN-25525'),('D920680','SDN-32643'),('D881998','SDN-55398'),('D963758','SDN-84129'),('D811787','SDN-42675'),('D689471','SDN-21622'),('D207099','SDN-18175'),('D405269','SDN-81798'),('D593299','SDN-50940'),('D645869','SDN-84717'),('D406395','SDN-94264'),('D272081','SDN-77552'),('D127873','SDN-52125')]\nC={r['customer_id']:r for r in csv.DictReader(open('/app/dev/customers_dev.csv',encoding='utf8'))}\nfor cid,uid in checks:\n c=C[cid]; e=W[uid]\n print('\\\\n',cid,c['full_name'],'=>',uid,e['primary_name'],e['dob'])\n if c['type']=='individual':\n  print(' C',m.individual_tokens(c['full_name']),m.individual_signatures(c['full_name']))\n  for n in [e['primary_name']]+([e['script_name']] if e.get('script_name') else [])+[a['name'] for a in e['aliases'] if a['strength']=='strong']:\n   print(' W',repr(n),m.individual_tokens(n),m.individual_signatures(n))\n else:\n  print('keys',m.entity_key(c['full_name']),m.entity_key(e['primary_name']))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
