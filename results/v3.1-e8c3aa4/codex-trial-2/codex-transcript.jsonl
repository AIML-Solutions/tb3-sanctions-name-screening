{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json,re,unicodedata,collections\nW=json.load(open('/app/watchlist.json',encoding='utf8'))\ndef script(s):\n if re.search('[\\\\u0600-\\\\u06ff]',s): return 'arabic'\n if re.search('[\\\\u0400-\\\\u04ff]',s): return 'cyrillic'\n return 'latin'\ndef toks(s):\n s=''.join(c for c in unicodedata.normalize('NFKD',s) if not unicodedata.combining(c)).lower()\n return re.findall(r\\\"[a-z]+\\\",s)\nfor group in ['latin','arabic','cyrillic']:\n xs=[e for e in W if e['type']=='individual' and script(e.get('script_name') or e['primary_name'])==group]\n vocab=collections.Counter(t for e in xs for n in [e['primary_name']]+[a['name'] for a in e['aliases'] if a['strength']=='strong'] if script(n)=='latin' for t in toks(n))\n print('\\\\n',group,'entries',len(xs),'latin vocab',len(vocab))\n print(' '.join(sorted(vocab)))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
