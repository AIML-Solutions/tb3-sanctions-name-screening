{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport csv,json,difflib,re,unicodedata\nW=json.load(open('/app/watchlist.json',encoding='utf8'))\nC={r['customer_id']:r for r in csv.DictReader(open('/app/dev/customers_dev.csv',encoding='utf8'))}\nL=list(csv.DictReader(open('/app/dev/labels_dev.csv',encoding='utf8')))\ndef asc(s): return ''.join(c for c in unicodedata.normalize('NFKD',s.lower()) if not unicodedata.combining(c))\ndef ratio(a,b): return difflib.SequenceMatcher(None,asc(a),asc(b)).ratio()\nfor cls in ['D1_name_dob_conflict','D2_near_name','D5_partial_dob_conflict','D6_same_given']:\n print('\\\\n###',cls)\n for l in [x for x in L if x['class']==cls]:\n  c=C[l['customer_id']]\n  pool=[e for e in W if e['type']==c['type']]\n  near=sorted(((max([(ratio(c['full_name'],n),n) for n in [e['primary_name']]+[a['name'] for a in e['aliases'] if a['strength']=='strong']]),e) for e in pool),key=lambda x:x[0],reverse=True)[:2]\n  print(c['customer_id'],repr(c['full_name']),repr(c['dob']),'~',[(round(q[0][0],2),q[0][1],q[1]['uid'],q[1]['dob']) for q in near])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
