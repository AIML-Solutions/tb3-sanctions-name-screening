{"type":"item.started","item":{"id":"item_55","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport csv,json,difflib,unicodedata,collections\nW=json.load(open('/app/watchlist.json'));C=list(csv.DictReader(open('/app/customers.csv')));P={x['customer_id']:x for x in csv.DictReader(open('/app/decisions.csv'))};by=collections.defaultdict(list)\nfor e in W:\n if e['type']=='individual' and len(e['dob'])==10:by[e['dob']].append(e)\ndef f(s):return ''.join(x for x in unicodedata.normalize('NFKD',s.casefold()) if not unicodedata.combining(x))\ndef sc(n,e):return max((difflib.SequenceMatcher(None,f(n),f(x)).ratio(),x) for x in [e['primary_name']]+[a['name'] for a in e['aliases'] if a['strength']=='strong'])\nz=[]\nfor c in C:\n if c['type']=='individual' and len(c['dob'])==10 and P[c['customer_id']]['decision']=='NO_MATCH' and by[c['dob']]:\n  q=max(((sc(c['full_name'],e),e) for e in by[c['dob']]),key=lambda x:x[0][0])\n  if q[0][0]>=.45:z.append((q[0][0],c,q))\nprint(len(z))\nfor x,c,q in sorted(z,reverse=True,key=lambda x:x[0]):print(c['customer_id'],repr(c['full_name']),c['dob'],'~',round(x,2),q[0][1],q[1]['uid'],repr(q[1]['primary_name']))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
