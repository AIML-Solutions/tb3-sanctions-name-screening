{"type":"item.started","item":{"id":"item_77","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport csv,json,importlib.util,collections,difflib\ns=importlib.util.spec_from_file_location('s','/app/screen.py');m=importlib.util.module_from_spec(s);s.loader.exec_module(m)\ndef keys(n):\n sig=m.individual_signatures(n)\n out=[]\n for z in sig:\n  if z[0]=='p':out.append(''.join(z[1:]))\n  elif z[0]=='c':out.append(z[1]+z[2])\n return set(out)\ndef grams(x):return {x[i:i+2] for i in range(len(x)-1)}\nrec=[];ix=collections.defaultdict(set)\nfor e in json.load(open('/app/watchlist.json',encoding='utf8')):\n if e['type']\"'!='\"'individual':continue\n for n in [e['primary_name'],e.get('script_name') or '']+[a['name'] for a in e['aliases'] if a['strength']=='strong']:\n  if not n:continue\n  for k in keys(n):\n   j=len(rec);rec.append((e,k,n))\n   for g in grams(k):ix[g].add(j)\np={r['customer_id']:r for r in csv.DictReader(open('/tmp/decisions_current6.csv'))};arr=[]\nfor c in csv.DictReader(open('/app/customers.csv',encoding='utf8')):\n if c['type']\"'!='\"'individual' or p[c['customer_id']]['decision']=='MATCH':continue\n best=(0,None,None,None)\n for ck in keys(c['full_name']):\n  counts=collections.Counter(j for g in grams(ck) for j in ix[g])\n  for j,_ in counts.most_common(150):\n   e,ek,en=rec[j]\n   if not m.dob_compatible(c['dob'],e['dob']):continue\n   z=difflib.SequenceMatcher(None,ck,ek).ratio()\n   if z>best[0]:best=(z,e,en,(ck,ek))\n if best[0]>=.80:arr.append((best,c))\narr.sort(reverse=True,key=lambda x:x[0][0])\nfor (z,e,en,ks),c in arr:print(f\\\"{z:.3f}|{c['customer_id']}|{c['full_name']}|{c['dob']}|{e['uid']}|{en}|{e['dob']}|{ks}\\\")\nprint('COUNT',len(arr))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
