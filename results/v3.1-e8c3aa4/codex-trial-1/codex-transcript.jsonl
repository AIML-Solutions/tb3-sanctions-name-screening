{"type":"item.started","item":{"id":"item_51","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport csv,json,importlib.util,itertools\nsp=importlib.util.spec_from_file_location('s','/app/screen.py');m=importlib.util.module_from_spec(sp);sp.loader.exec_module(m)\ndef toks(n):return m.combine_name_parts(m.raw_words(n))\ndef lev(a,b):\n prev=list(range(len(b)+1))\n for i,x in enumerate(a,1):\n  cur=[i]\n  for j,y in enumerate(b,1):cur.append(min(cur[-1]+1,prev[j]+1,prev[j-1]+(x\"'!=y)))\n  prev=cur\n return prev[-1]\ndef tsim(a,b):return 1-lev(a,b)/max(len(a),len(b),1)\ndef nscore(a,b):\n if len(a)!=len(b) or not a:return (0,0)\n if len(a)>4:return (0,0)\n best=(0,0)\n for p in itertools.permutations(b):\n  ss=[tsim(x,y) for x,y in zip(a,p)];z=(min(ss),sum(ss)/len(ss))\n  if z>best:best=z\n return best\nw=[]\nfor e in json.load(open('\"'/app/watchlist.json',encoding='utf8')):\n if e['type']=='individual':\n  ns=[e['primary_name'],e.get('script_name') or '']+[a['name'] for a in e['aliases'] if a['strength']=='strong']\n  w.append((e,[toks(n) for n in ns if n]))\np={r['customer_id']:r for r in csv.DictReader(open('/tmp/decisions_current3.csv'))};arr=[]\nfor c in csv.DictReader(open('/app/customers.csv',encoding='utf8')):\n if c['type']\"'!='\"'individual' or p[c['customer_id']]['decision']=='MATCH':continue\n ct=toks(c['full_name']);best=(0,0);beste=None;bestn=None\n for e,ens in w:\n  if not m.dob_compatible(c['dob'],e['dob']):continue\n  for en in ens:\n   z=nscore(ct,en)\n   if z>best:best,beste,bestn=z,e,en\n if beste and best[0]>=.70 and best[1]>=.82:arr.append((best,c,beste,ct,bestn))\narr.sort(reverse=True,key=lambda x:x[0])\nfor z,c,e,ct,et in arr:print(f\\\"{z[0]:.2f},{z[1]:.2f}|{c['customer_id']}|{c['full_name']}|{c['dob']}|{e['uid']}|{e['primary_name']}|{e['dob']}|{ct}|{et}\\\")\nprint('COUNT',len(arr))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
