{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"python3 -m py_compile /app/screen.py && time python3 /app/screen.py --watchlist /app/watchlist.json --customers /app/dev/customers_dev.csv --out /tmp/dev_out.csv && python3 - <<'PY'\nimport csv,collections\npred={r['customer_id']:r for r in csv.DictReader(open('/tmp/dev_out.csv'))}\nlabs=list(csv.DictReader(open('/app/dev/labels_dev.csv')))\nstats=collections.defaultdict(lambda:collections.Counter())\nwrong=[]\nfor x in labs:\n p=pred[x['customer_id']]\n okay=p['decision']==x['expected_decision'] and (p['decision']=='NO_MATCH' or p['matched_uid']==x['expected_uid'])\n stats[x['class']]['n']+=1;stats[x['class']]['ok']+=okay\n if not okay: wrong.append((x,p))\nprint('overall',len(labs)-len(wrong),'/',len(labs),'wrong',len(wrong))\nfor cl,s in sorted(stats.items()): print(f\\\"{cl:28} {s['ok']:4}/{s['n']:4} {s['ok']/s['n']:.3f}\\\")\nprint('decision confusion',collections.Counter((x['expected_decision'],p['decision']) for x,p in wrong))\nprint('uid only',sum(x['expected_decision']=='MATCH' and p['decision']=='MATCH' for x,p in wrong))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
