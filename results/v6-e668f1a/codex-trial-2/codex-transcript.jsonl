{"type":"item.started","item":{"id":"item_49","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport csv,json,difflib,re,unicodedata\ncs=list(csv.DictReader(open('/app/customers.csv'))); dec={r['customer_id']:r for r in csv.DictReader(open('/app/decisions.csv'))}; wl=json.load(open('/app/watchlist.json'))\ndef norm(s):\n s=''.join(c for c in unicodedata.normalize('NFKD',s.casefold()) if not unicodedata.combining(c));return ''.join(re.findall('[a-z]+',s))\nfor c in cs:\n if c['type']\"'!='\"'individual' or dec[c['customer_id']]['decision']\"'!='\"'NO_MATCH' or not c['dob']:continue\n es=[e for e in wl if e['type']=='individual' and e['dob'] and e['dob'].startswith(c['dob'])]\n if not es:continue\n scored=[]\n for e in es:\n  ns=[e['primary_name']]+([e['script_name']] if e.get('script_name') else[])+[a['name']for a in e['aliases']if a['strength']=='strong']\n  score=max(difflib.SequenceMatcher(None,norm(c['full_name']),norm(n)).ratio()for n in ns)\n  scored.append((score,e))\n score,e=max(scored,key=lambda x:x[0])\n if score>.35:\n  print(c['customer_id'],'|',c['full_name'],'|',c['dob'],'=>',e['uid'],e['primary_name'],'|',e.get('script_name'),'dob',e['dob'],'score',round(score,2))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
