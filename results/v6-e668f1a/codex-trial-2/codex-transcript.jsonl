{"type":"item.started","item":{"id":"item_61","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport sys,csv,json,difflib\nsys.path.insert(0,'/app');import screen\nwl=json.load(open('/app/watchlist.json'));eng=screen.Engine(wl);cs=list(csv.DictReader(open('/app/customers.csv')));de={x['customer_id']:x for x in csv.DictReader(open('/app/decisions.csv'))}\ninds=[e for e in wl if e['type']=='individual']\nfor c in cs:\n if c['type']\"'!='\"'individual'or de[c['customer_id']]['decision']\"'!='\"'NO_MATCH':continue\n best=(0,None,None,None)\n for e in inds:\n  if not screen.dob_compatible(c['dob'],e['dob']):continue\n  cul=eng.culture(e); cc=screen.detect_culture(c['full_name']);cc=cul if cc=='western'else cc\n  csigs=screen.person_signatures(c['full_name'],cc)\n  for name in eng._listed_names(e):\n   lc=screen.detect_culture(name);lc=cul if lc=='western'else lc\n   for a in csigs:\n    for b in screen.person_signatures(name,lc):\n     x=difflib.SequenceMatcher(None,a[0],b[0]).ratio();y=difflib.SequenceMatcher(None,a[1],b[1]).ratio()\n     score=min(x,y)*.7+(x+y)/2*.3\n     if score>best[0]:best=(score,e,a,b)\n score,e,a,b=best\n if score>=.72:\n  print(c['customer_id'],'|',c['full_name'],'|',c['dob'],'=>',e['uid'],e['primary_name'],'|',e['dob'],'score',round(score,3),a,b)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
