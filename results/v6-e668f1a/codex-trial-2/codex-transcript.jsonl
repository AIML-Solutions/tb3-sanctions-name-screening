{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json,re,collections,unicodedata\nwl=json.load(open('/app/watchlist.json'))\ninds=[e for e in wl if e['type']=='individual']\ndef sc(s):\n if not s:return 'latin'\n for c in s:\n  n=unicodedata.name(c,'')\n  if 'ARABIC' in n:return 'arabic'\n  if 'CYRILLIC' in n:return 'cyrillic'\n return 'latin'\nprint(collections.Counter(sc(e['primary_name']) for e in inds),collections.Counter(sc(e.get('script_name')) for e in inds))\nfor culture in ['latin','cyrillic','arabic']:\n es=[e for e in inds if sc(e.get('script_name') or e['primary_name'])==culture]\n print('\\\\n##',culture,len(es))\n for e in es[:200]:\n  print(e['uid'],'|',e['primary_name'],'|',e.get('script_name'),'|','; '.join(a['strength']+':'+a['name'] for a in e['aliases']))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
