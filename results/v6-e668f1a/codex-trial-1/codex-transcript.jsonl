{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport csv,json,re,unicodedata,difflib\nW=json.load(open('/app/watchlist.json')); C={r['customer_id']:r for r in csv.DictReader(open('/app/dev/customers_dev.csv'))}; L=list(csv.DictReader(open('/app/dev/labels_dev.csv')))\ndef fold(s):\n s=unicodedata.normalize('NFKD',s.lower()).replace('ø','o').replace('ß','ss')\n s=''.join(c for c in s if not unicodedata.combining(c))\n return re.findall('[a-z]+',s)\ndef sim(a,b): return difflib.SequenceMatcher(None,a,b).ratio()\nfor cls in ('D2_near_name','D6_same_given'):\n print('\\\\n',cls)\n for x in [z for z in L if z['class']==cls]:\n  c=C[x['customer_id']]; ct=fold(c['full_name']); scored=[]\n  for e in W:\n   if e['type']\"'!='\"'individual' or not re.match('\"'^[A-Za-zÀ-ž]'\"',e['primary_name']): continue\n   for n in [e['primary_name']]+[a['name'] for a in e['aliases'] if a['strength']=='strong']:\n    et=fold(n)\n    if not ct or not et:continue\n    # endpoints in either order average\n    z=max((sim(ct[0],et[0])+sim(ct[-1],et[-1]))/2,(sim(ct[0],et[-1])+sim(ct[-1],et[0]))/2)\n    scored.append((z,e['uid'],e['primary_name'],e['dob']))\n  print(c['full_name'],c['dob'],' :: ',*sorted(scored,reverse=True)[:3])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
