{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json,re,unicodedata,collections\nW=json.load(open('/app/watchlist.json'))\ndef issc(s): return bool(re.search(r'[\\\\u0400-\\\\u04ff\\\\u0600-\\\\u06ff]',s or ''))\ndef toks(s): return re.findall(r\\\"[\"'^'\"\\\\W\\\\d_]+\\\",unicodedata.normalize('NFKC',s).lower(),re.UNICODE)\n# print primary Latin endpoint/middle unique grouped by script type\nfor culture,pred in [('arab',lambda e: re.search(r'[\\\\u0600-\\\\u06ff]',e.get('script_name') or '')),('cyr',lambda e: re.search(r'[\\\\u0400-\\\\u04ff]',e.get('script_name') or '')),('west',lambda e:not e.get('script_name'))]:\n first=collections.Counter(); last=collections.Counter(); mid=collections.Counter()\n for e in W:\n  if e['type']\"'!='\"'individual' or not pred(e) or issc(e['primary_name']):continue\n  ts=[x for x in toks(e['primary_name']) if x not in ('al','el','bin','ibn','ben','b')]\n  if ts: first[ts[0]]+=1; last[ts[-1]]+=1; mid.update(ts[1:-1])\n print('\\\\n##',culture,'first',len(first));print(' '.join(sorted(first)))\n print('last',len(last));print(' '.join(sorted(last)))\n print('mid',len(mid));print(' '.join(sorted(mid)))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
