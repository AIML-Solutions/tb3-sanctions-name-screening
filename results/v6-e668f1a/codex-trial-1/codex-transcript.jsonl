{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json,collections,re\nW=json.load(open('/app/watchlist.json'))\nprint(collections.Counter(e['type'] for e in W))\nfor typ in ('individual','entity','vessel'):\n print('\\\\n###',typ)\n es=[e for e in W if e['type']==typ]\n for e in es[:50]: print(e['uid'],e['primary_name'],'|',e.get('script_name'),'|',[(a['name'],a['strength']) for a in e['aliases']])\n# all latin-looking individual primary names by broad culture indication\nfor label,pred in [\n ('latin_no_script',lambda e:not e.get('script_name')),\n ('arabic_script',lambda e:e.get('script_name') and re.search(r'[\\\\u0600-\\\\u06ff]',e['script_name'])),\n ('cyrillic_script',lambda e:e.get('script_name') and re.search(r'[\\\\u0400-\\\\u04ff]',e['script_name']))]:\n names=[e['primary_name'] for e in W if e['type']=='individual' and pred(e)]\n print('\\\\n',label,len(names))\n print('\\\\n'.join(names[:120]))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
