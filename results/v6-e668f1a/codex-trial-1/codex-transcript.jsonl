{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json,re,unicodedata,collections\nW=json.load(open('/app/watchlist.json'))\ndef script(s): return bool(re.search(r'[\\\\u0400-\\\\u04ff\\\\u0600-\\\\u06ff]',s or ''))\ndef toks(s):\n s=unicodedata.normalize('NFKC',s.lower())\n s=re.sub(r\\\"[\"'^'\"\\\\w]+\\\",' ',s,flags=re.UNICODE)\n return s.split()\nfor kind,rg in [('arab',r'[\\\\u0600-\\\\u06ff]'),('cyr',r'[\\\\u0400-\\\\u04ff]')]:\n m=collections.defaultdict(collections.Counter)\n for e in W:\n  sn=e.get('script_name') or ''\n  if not re.search(rg,sn): continue\n  lat=[]\n  if not script(e['primary_name']): lat.append(e['primary_name'])\n  lat += [a['name'] for a in e['aliases'] if a['strength']=='strong' and not script(a['name'])]\n  st=toks(sn)\n  for name in lat:\n   lt=toks(name)\n   if len(st)==len(lt):\n    for a,b in zip(st,lt): m[a][b]+=1\n allorig=[]\n for e in W:\n  if re.search(rg,e['primary_name']): allorig += toks(e['primary_name'])\n print(kind,'map keys',len(m),'orig tokens',len(set(allorig)),'covered',len(set(allorig)&set(m)),'missing',sorted(set(allorig)-set(m)))\n print('ambiguous')\n for a,c in m.items():\n  if len(c)>1: print(a,c.most_common(8))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
