{"type":"item.started","item":{"id":"item_67","type":"command_execution","command":"/bin/bash -lc \"python3 /app/screen.py --watchlist /app/watchlist.json --customers /app/customers.csv --out /app/decisions.csv\npython3 - <<'PY'\nimport csv,json,importlib.util,difflib\nsp=importlib.util.spec_from_file_location('s','/app/screen.py');s=importlib.util.module_from_spec(sp);sp.loader.exec_module(s)\nW=json.load(open('/app/watchlist.json'));D=s.build_script_dictionary(W); C=list(csv.DictReader(open('/app/customers.csv'))); P={r['customer_id']:r for r in csv.DictReader(open('/app/decisions.csv'))}\npre=[]\nfor e in W:\n if e['type']\"'!='\"'individual':continue\n m=s.script_kind(e.get('script_name') or e['primary_name']); cores=[]\n for n in [e['primary_name'],e.get('script_name') or '']+[a['name'] for a in e['aliases'] if a['strength']=='strong']:\n  z=s.person_core(n,m,D) if n else None\n  if z and z not in cores:cores.append(z)\n pre.append((e,m,cores))\ndef sm(a,b):return max(sum(difflib.SequenceMatcher(None,x,y).ratio() for x,y in zip(a,b))/2,sum(difflib.SequenceMatcher(None,x,y).ratio() for x,y in zip(a,b[::-1]))/2)\nR=[]\nfor c in C:\n if c['type']\"'!='\"'individual' or P[c['customer_id']]['decision']=='MATCH' or c['dob']:continue\n best=[]\n for e,m,cs in pre:\n  cc=s.person_core(c['full_name'],m,D)\n  z=max((sm(cc,q) for q in cs),default=0) if cc else 0\n  best.append((z,e))\n for z,e in sorted(best,key=lambda x:-x[0])[:1]:\n  if z>=.72:R.append((z,c,e))\nprint('rows',len(R))\nfor z,c,e in sorted(R,key=lambda x:-x[0]):print(f'{z:.3f}',c['customer_id'],repr(c['full_name']),'id',c['id_number'],'=>',e['uid'],repr(e['primary_name']),'dob',e['dob'])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
