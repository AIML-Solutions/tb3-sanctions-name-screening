{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport csv,json,collections\nW={e['uid']:e for e in json.load(open('/app/watchlist.json'))}\nC={r['customer_id']:r for r in csv.DictReader(open('/app/dev/customers_dev.csv'))}\nL=list(csv.DictReader(open('/app/dev/labels_dev.csv')))\nprint('classes:')\nfor k,v in collections.Counter(x['class'] for x in L).most_common(): print(k,v)\nfor cls in sorted(set(x['class'] for x in L)):\n print('\\\\n###',cls)\n for x in [z for z in L if z['class']==cls][:12]:\n  c=C[x['customer_id']]; e=W.get(x['expected_uid'])\n  print(c['customer_id'],repr(c['full_name']),c['dob'],c['id_type'],c['id_number'],'=>',x['expected_decision'], x['expected_uid'], '|', (repr(e['primary_name'])+' / '+repr(e.get('script_name'))+' dob='+e['dob']) if e else '')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
