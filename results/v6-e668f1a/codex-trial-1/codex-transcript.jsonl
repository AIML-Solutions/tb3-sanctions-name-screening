{"type":"item.started","item":{"id":"item_48","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport csv,json,importlib.util,difflib\nsp=importlib.util.spec_from_file_location('s','/app/screen.py');s=importlib.util.module_from_spec(sp);sp.loader.exec_module(s)\nW=json.load(open('/app/watchlist.json'));D=s.build_script_dictionary(W); C=list(csv.DictReader(open('/app/customers.csv'))); P={r['customer_id']:r for r in csv.DictReader(open('/app/decisions.csv'))}\npre=[]\nfor e in W:\n if e['type']\"'!='\"'individual':continue\n m=s.script_kind(e.get('script_name') or e['primary_name']); cores=[]\n for n in [e['primary_name'],e.get('script_name') or '']+[a['name'] for a in e['aliases'] if a['strength']=='strong']:\n  if n:\n   z=s.person_core(n,m,D)\n   if z and z not in cores:cores.append(z)\n pre.append((e,m,cores))\ndef tsim(a,b):\n return max((difflib.SequenceMatcher(None,a[0],b[0]).ratio()+difflib.SequenceMatcher(None,a[1],b[1]).ratio())/2,(difflib.SequenceMatcher(None,a[0],b[1]).ratio()+difflib.SequenceMatcher(None,a[1],b[0]).ratio())/2)\nrows=[]\nfor c in C:\n if c['type']\"'!='\"'individual' or P[c['customer_id']]['decision']=='MATCH' or not c['dob']:continue\n best=[]\n for e,m,cores in pre:\n  if not e['dob'] or not s.dob_compatible(c['dob'],e['dob']):continue\n  cc=s.person_core(c['full_name'],m,D)\n  if not cc:continue\n  sc=max([tsim(cc,z) for z in cores],default=0)\n  best.append((sc,e['uid'],e['primary_name'],e['dob'],cc,cores[0] if cores else None))\n if best:\n  b=max(best)\n  if b[0]>=.55: rows.append((b[0],c,b))\nprint('same-DOB plausible count',len(rows))\nfor sc,c,b in sorted(rows,reverse=True)[:250]:print(f\\\"{sc:.3f}\\\",c['customer_id'],repr(c['full_name']),c['dob'],'=>',b[1],repr(b[2]),b[3],b[4],b[5])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
