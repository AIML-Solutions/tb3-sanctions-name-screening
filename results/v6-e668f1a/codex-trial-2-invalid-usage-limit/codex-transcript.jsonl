{"type":"item.started","item":{"id":"item_62","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport csv,json,difflib,re,screen\nW=[e for e in json.load(open('watchlist.json')) if e['type']=='individual']\nP={r['customer_id']:r for r in csv.DictReader(open('/tmp/batch_pred.csv'))}\nC=list(csv.DictReader(open('customers.csv')))\ndef key(s): return ''.join(screen.person_tokens(s))\nrows=[]\nfor c in C:\n if c['type']\"'!='\"'individual' or P[c['customer_id']]['decision']=='MATCH' or len(c['dob'])\"'!=10: continue\n cand=[e for e in W if e['\"'dob']==c['dob']]\n if not cand: continue\n best=[]\n for e in cand:\n  names=[e['primary_name'],e.get('script_name') or '']+[a['name'] for a in e['aliases'] if a['strength']=='strong']\n  score=max(difflib.SequenceMatcher(None,key(c['full_name']),key(n)).ratio() for n in names if n)\n  best.append((score,e))\n score,e=max(best,key=lambda x:x[0])\n if score>=.35: rows.append((score,c,e,key(c['full_name']),key(e['primary_name'])))\nfor score,c,e,k1,k2 in sorted(rows,reverse=True):\n print(f\\\"{score:.2f}|{c['customer_id']}|{c['full_name']}|{c['dob']}|{e['uid']}|{e['primary_name']}|{e.get('script_name') or ''}|{k1}|{k2}\\\")\nprint('count',len(rows))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
