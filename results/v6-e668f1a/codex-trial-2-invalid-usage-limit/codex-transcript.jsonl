{"type":"item.started","item":{"id":"item_64","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport csv,json,difflib,screen\nW=[e for e in json.load(open('watchlist.json')) if e['type']=='individual']; P={r['customer_id']:r for r in csv.DictReader(open('/tmp/batch_pred.csv'))}; C=list(csv.DictReader(open('customers.csv')))\nlisted={(i['type'],i['number']) for e in W for i in e['ids']}\ndef key(s): return ''.join(screen.person_tokens(s))\nrows=[]\nfor c in C:\n if c['type']\"'!='\"'individual' or P[c['customer_id']]['decision']=='MATCH': continue\n if not ((c['id_number'] and (c['id_type'],c['id_number']) not in listed) or not c['dob']): continue\n best=[]\n for e in W:\n  if c['dob'] and e['dob'] and not e['dob'].startswith(c['dob']): continue\n  names=[e['primary_name'],e.get('script_name') or '']+[a['name'] for a in e['aliases'] if a['strength']=='strong']\n  sc=max(difflib.SequenceMatcher(None,key(c['full_name']),key(n)).ratio() for n in names if n)\n  best.append((sc,e['uid'],e))\n sc,_,e=max(best,key=lambda x:(x[0],x[1]))\n if sc>=.78: rows.append((sc,c,e))\nfor sc,c,e in sorted(rows,key=lambda x:x[0],reverse=True): print(f\\\"{sc:.2f}|{c['customer_id']}|{c['full_name']}|{c['dob']}|{c['id_number']}|{e['uid']}|{e['primary_name']}|{e['dob']}\\\")\nprint('count',len(rows))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
