{"type":"item.completed","item":{"id":"item_4","type":"agent_message","text":"The inputs are deliberately broad: 2,100 watchlist records and 1,304 labelled development customers across 21 match/decoy classes. The policy’s main precision trap is that permissible transliteration can look like ordinary fuzzy spelling, so I’m separating rule-based phonetic equivalence from typo similarity rather than using a generic edit-distance threshold."}}
{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport csv,json,re,unicodedata,difflib,collections\nW=json.load(open('watchlist.json',encoding='utf8'))\nC={r['customer_id']:r for r in csv.DictReader(open('dev/customers_dev.csv',encoding='utf8'))}\nL=list(csv.DictReader(open('dev/labels_dev.csv',encoding='utf8')))\ndef n(s):\n s=''.join(c for c in unicodedata.normalize('NFKD',s.lower()) if not unicodedata.combining(c))\n return ''.join(c for c in s if c.isascii() and c.isalpha())\nfor cls in ['T1_translit','T2_script','T10_stacked','T11_twin','T12_script_customer','D2_near_name','D6_same_given']:\n print('\\\\n###',cls)\n rows=[r for r in L if r['class']==cls]\n for r in rows[:60]:\n  c=C[r['customer_id']]\n  if r['expected_uid']:\n   e=next(x for x in W if x['uid']==r['expected_uid'])\n   target=e['primary_name']\n  else:\n   same=[e for e in W if e['type']==c['type']]\n   e=max(same,key=lambda x:difflib.SequenceMatcher(None,n(c['full_name']),n(x['primary_name'])).ratio())\n   target=e['primary_name']\n  print(f\\\"{c['full_name']} => {target} [{r['expected_uid'] or e['uid']}] dob {c['dob']} / {e['dob']}\\\")\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
