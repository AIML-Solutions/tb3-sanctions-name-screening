{"type":"item.started","item":{"id":"item_95","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport csv,json,difflib,screen,collections\nW=[e for e in json.load(open('watchlist.json')) if e['type']=='individual']; P={r['customer_id']:r for r in csv.DictReader(open('/tmp/batch_pred4.csv'))}; C=list(csv.DictReader(open('customers.csv'))); listed={(i['type'],i['number']) for e in W for i in e['ids']}\nWK=[]; inv=collections.defaultdict(set)\nfor n,e in enumerate(W):\n names=[e['primary_name'],e.get('script_name') or '']+[a['name'] for a in e['aliases'] if a['strength']=='strong']; ks=[screen.person_tokens(x) for x in names if x]; WK.append((e,ks))\n for k in ks:\n  for t in k: inv[t].add(n)\nrows=[]\nfor c in C:\n if c['type']\"'!='\"'individual' or P[c['customer_id']]['decision']=='MATCH': continue\n if not ((c['id_number'] and (c['id_type'],c['id_number']) not in listed) or not c['dob']): continue\n ck=screen.person_tokens(c['full_name']); inds=set().union(*(inv[t] for t in ck)) if ck else set()\n vals=[]\n for n in inds:\n  e,ks=WK[n]\n  if c['dob'] and e['dob'] and not e['dob'].startswith(c['dob']): continue\n  a=''.join(ck); sc=max(difflib.SequenceMatcher(None,a,''.join(k)).ratio() for k in ks); vals.append((sc,e['uid'],e))\n if not vals: continue\n sc,_,e=max(vals,key=lambda x:(x[0],x[1]))\n if sc>=.84: rows.append((sc,c,e))\nfor sc,c,e in sorted(rows,key=lambda x:x[0],reverse=True): print(f\\\"{sc:.2f}|{c['customer_id']}|{c['full_name']}|{c['dob']}|{c['id_number']}|{e['uid']}|{e['primary_name']}|{e['dob']}\\\")\nprint('count',len(rows))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
