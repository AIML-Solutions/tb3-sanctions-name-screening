{"type":"item.started","item":{"id":"item_80","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport csv,json,difflib,screen\nW=[e for e in json.load(open('watchlist.json')) if e['type']=='individual']; P={r['customer_id']:r for r in csv.DictReader(open('/tmp/batch_pred2.csv'))}; C=list(csv.DictReader(open('customers.csv')))\ndef key(s): return ''.join(screen.person_tokens(s))\nrows=[]\nfor c in C:\n if c['type']\"'!='\"'individual' or P[c['customer_id']]['decision']=='MATCH' or len(c['dob'])\"'!=10: continue\n cand=[e for e in W if e['\"'dob']==c['dob']]\n if not cand: continue\n vals=[]\n for e in cand:\n  ns=[e['primary_name'],e.get('script_name') or '']+[a['name'] for a in e['aliases'] if a['strength']=='strong']; sc=max(difflib.SequenceMatcher(None,key(c['full_name']),key(n)).ratio() for n in ns if n); vals.append((sc,e['uid'],e))\n sc,_,e=max(vals,key=lambda x:(x[0],x[1]))\n if sc>=.72: rows.append((sc,c,e))\nfor sc,c,e in sorted(rows,key=lambda x:x[0],reverse=True): print(f\\\"{sc:.2f}|{c['customer_id']}|{c['full_name']}|{c['dob']}|{e['uid']}|{e['primary_name']}\\\")\nprint('count',len(rows))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
