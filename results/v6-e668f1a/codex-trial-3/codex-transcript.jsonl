{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport csv,json,collections,screen\nwl=json.load(open('watchlist.json')); wd={x['uid']:x for x in wl}; nm=screen.NameMatcher(wl)\ncs={x['customer_id']:x for x in csv.DictReader(open('dev/customers_dev.csv'))}\npred={x['customer_id']:x for x in csv.DictReader(open('/tmp/dev_decisions.csv'))}\nlabels=list(csv.DictReader(open('dev/labels_dev.csv')))\nfor l in labels:\n p=pred[l['customer_id']]\n if l['expected_decision']=='MATCH' and (p['decision']\"'!='\"'MATCH' or p['matched_uid']\"'!=l['\"'expected_uid']):\n  c=cs[l['customer_id']]; e=wd[l['expected_uid']]\n  print('\\\\n',l['customer_id'],l['class'],'PRED',p['matched_uid'])\n  print(' C',c['full_name'],c['dob'],c['type'])\n  print(' E',e['primary_name'],'|',e['script_name'],'|',e['dob'],'aliases',e['aliases'])\n  if c['type']=='individual':\n   print(' cores',screen.individual_core(c['full_name']),screen.individual_core(e['primary_name']))\n   print(' Ckeys',[(x,sorted(nm.token_keys(x))) for x in screen.individual_core(c['full_name'])])\n   print(' Ekeys',[(x,sorted(nm.token_keys(x))) for x in screen.individual_core(e['primary_name'])])\n  elif c['type']=='entity': print(' keys',screen.entity_key(c['full_name']),screen.entity_key(e['primary_name']))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
