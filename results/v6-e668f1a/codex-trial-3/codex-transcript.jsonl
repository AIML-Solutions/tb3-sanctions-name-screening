{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"python3 -m py_compile screen.py && /usr/bin/time -f 'elapsed %e sec maxrss %M KB' python3 screen.py --watchlist watchlist.json --customers dev/customers_dev.csv --out /tmp/dev_decisions.csv\npython3 - <<'PY'\nimport csv,collections\npred={x['customer_id']:x for x in csv.DictReader(open('/tmp/dev_decisions.csv'))}\nlab=list(csv.DictReader(open('dev/labels_dev.csv')))\nconf=collections.Counter()\nby=collections.defaultdict(collections.Counter)\nwrong=[]\nfor x in lab:\n p=pred[x['customer_id']]\n ok=p['decision']==x['expected_decision'] and (p['decision']=='NO_MATCH' or p['matched_uid']==x['expected_uid'])\n conf[(x['expected_decision'],p['decision'])]+=1\n by[x['class']]['n']+=1; by[x['class']]['ok']+=ok\n if not ok: wrong.append((x,p))\nprint('conf',conf,'exact',len(lab)-len(wrong),'/',len(lab), (len(lab)-len(wrong))/len(lab))\nfor k in sorted(by): print(k,by[k]['ok'],'/',by[k]['n'],f\\\"{by[k]['ok']/by[k]['n']:.3f}\\\")\nprint('wrong',len(wrong))\nfor x,p in wrong[:100]: print(x,p)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
