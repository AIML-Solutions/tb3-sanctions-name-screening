{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json,re,collections\nw=json.load(open('watchlist.json'))\n\ndef toks(s):\n s=re.sub(r'[-,]',' ',s)\n return s.split()\nfor kind,rg in [('ar',r'[\\\\u0600-\\\\u06ff]'),('ru',r'[\\\\u0400-\\\\u052f]')]:\n allw=set(); mapped=collections.defaultdict(set); pairs=0\n for e in w:\n  sn=e['script_name'] or ''\n  if not re.search(rg,sn): continue\n  st=toks(sn)\n  allw.update(st)\n  p=e['primary_name']\n  if re.search(rg,p): continue\n  pt=toks(p)\n  if len(st)==len(pt):\n   pairs+=1\n   for a,b in zip(st,pt): mapped[a].add(b)\n print(kind,'script tokens',len(allw),'mapped raw',len(mapped),'unmapped',len(allw-set(mapped)),'aligned records',pairs)\n print('unmapped',sorted(allw-set(mapped))[:100])\n print('ambig',[(k,v) for k,v in mapped.items() if len(v)>1][:30])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
