{"type":"item.started","item":{"id":"item_77","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport csv,json,screen,functools,itertools\nw=json.load(open('watchlist.json'));wd={e['uid']:e for e in w};m=screen.NameMatcher(w);cs={x['customer_id']:x for x in csv.DictReader(open('customers.csv'))};ds=list(csv.DictReader(open('decisions.csv')))\n@functools.lru_cache(None)\ndef pk(t):return tuple(x[2:] for x in m.token_keys(t) if x.startswith('P:')) or (screen.prepared_latin(t),)\ndef lev(a,b):\n d=list(range(len(b)+1))\n for i,x in enumerate(a,1):\n  n=[i]\n  for j,y in enumerate(b,1):n.append(min(n[-1]+1,d[j]+1,d[j-1]+(x\"'!=y)))\n  d=n\n return d[-1]\ndef td(a,b):return min(lev(x,y)/max(len(x),len(y),1) for x in pk(a) for y in pk(b))\ndef score(a0,b0):\n a=screen.individual_core(a0);b=screen.individual_core(b0)\n if len(a)!=len(b):return 9\n return min(sum(td(x,y) for x,y in zip(a,p))/len(a) for p in itertools.permutations(b))\nout=[]\nfor d in ds:\n if d['\"'decision']\"'!='\"'MATCH':continue\n c=cs[d['customer_id']];e=wd[d['matched_uid']]\n if c['type']\"'!='\"'individual':continue\n if c['id_number'] and any(i['type']==c['id_type'] and i['number']==c['id_number'] for i in e['ids']):continue\n s=min(score(c['full_name'],f) for f in screen.screening_forms(e));out.append((s,c,e))\nout.sort(key=lambda x:-x[0]);print('name matches',len(out))\nfor s,c,e in out[:140]:print(f\\\"{s:.3f} {c['customer_id']} | {c['full_name']} | {c['dob']} => {e['uid']} | {e['primary_name']} | {e['dob']}\\\")\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
