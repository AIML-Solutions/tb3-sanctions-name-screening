{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport csv,json,collections\nwl=json.load(open('watchlist.json'))\nprint('watchlist type',collections.Counter(x['type'] for x in wl))\nprint('script_name present',sum(bool(x['script_name']) for x in wl),'primary nonascii',sum(not x['primary_name'].isascii() for x in wl))\nprint('alias strengths',collections.Counter(a['strength'] for x in wl for a in x['aliases']))\nprint('dob formats',collections.Counter(len(x['dob']) for x in wl))\nprint('id types',collections.Counter(i['type'] for x in wl for i in x['ids']))\nwith open('dev/labels_dev.csv',newline='') as f: labels=list(csv.DictReader(f))\nprint('\\\\nclasses:')\nfor k,v in sorted(collections.Counter((x['class'],x['expected_decision']) for x in labels).items()): print(k,v)\nprint('\\\\nWatchlist sample by category:')\nfor typ in ['individual','entity','vessel']:\n print('\\\\n',typ)\n for x in [z for z in wl if z['type']==typ][:12]: print(x)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
