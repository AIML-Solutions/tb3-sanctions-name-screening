{"type":"item.started","item":{"id":"item_81","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport csv,json,screen,functools,itertools\nw=json.load(open('watchlist.json'));m=screen.NameMatcher(w);cs=list(csv.DictReader(open('customers.csv')));dec={x['customer_id']:x for x in csv.DictReader(open('decisions.csv'))};forms=[(e,f) for e in w if e['type']=='individual' for f in screen.screening_forms(e)]\n@functools.lru_cache(None)\ndef pk(t):return tuple(x[2:] for x in m.token_keys(t) if x.startswith('P:')) or (screen.prepared_latin(t),)\n@functools.lru_cache(None)\ndef lev(a,b):\n d=list(range(len(b)+1))\n for i,x in enumerate(a,1):\n  n=[i]\n  for j,y in enumerate(b,1):n.append(min(n[-1]+1,d[j]+1,d[j-1]+(x\"'!=y)))\n  d=n\n return d[-1]\n@functools.lru_cache(None)\ndef td(a,b):return min(lev(x,y)/max(len(x),len(y),1) for x in pk(a) for y in pk(b))\ndef sc(a0,b0):\n a=screen.individual_core(a0);b=screen.individual_core(b0)\n if len(a)!=len(b) or len(a)<2:return 9\n return min(sum(td(x,y) for x,y in zip(a,p))/len(a) for p in itertools.permutations(b))\nout=[]\nfor c in cs:\n if c['\"'type']\"'!='\"'individual' or c['dob'] or dec[c['customer_id']]['decision']\"'!='\"'NO_MATCH':continue\n s,e=min((sc(c['full_name'],f),e) for e,f in forms)\n if s<=.18:out.append((s,c,e))\nout.sort(key=lambda z:z[0]);print(len(out))\nfor s,c,e in out:print(f\\\"{s:.3f} {c['customer_id']} {c['full_name']} => {e['uid']} {e['primary_name']}\\\")\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
